#!/usr/bin/env python3
"""A stand-in for a shared MCP server in sbd's integration tests.

Usage: mcp-stub <name> <port> [--delay <seconds>]

It answers every GET and POST with "<name> <pid>". With --delay, it waits
that long before it listens.
"""
import http.server
import os
import sys
import time

name, port = sys.argv[1], int(sys.argv[2])
if sys.argv[3:5] and sys.argv[3] == "--delay":
    time.sleep(float(sys.argv[4]))


class Handler(http.server.BaseHTTPRequestHandler):
    def answer(self):
        body = f"{name} {os.getpid()}".encode()
        self.send_response(200)
        self.send_header("Content-Type", "text/plain")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    do_GET = answer
    do_POST = answer

    def log_message(self, format, *args):
        pass


server = http.server.ThreadingHTTPServer(("127.0.0.1", port), Handler)
print(f"{name} listens on 127.0.0.1:{port}", flush=True)
server.serve_forever()
