#!/usr/bin/env bash
# With no arguments, or with --changed, runs only the tests that the files
# changed against origin/main can affect, as bin/lib/test-selection.sh picks
# them. Changed files include commits, uncommitted edits, and untracked files.
# With only --filter options, it builds only the test bundles that can hold
# the tests the filters match (pattern_targets in bin/lib/test-selection.sh),
# and skips the tests of the other bundles. When it cannot tell which bundles
# those are, and with any other arguments, swift test builds every bundle.
# With --all, runs every unit and integration test. With --claude first, it
# also runs the tests that drive the installed claude with Haiku, which take
# minutes and use some of your Claude quota. With --shards N, it splits the
# integration tests across N swift test processes and runs the other tests in
# one more, all at once, then runs MeasureTests alone. With --part K/P after
# the count, it splits the tests into P parts for P machines, such as the jobs
# of a CI matrix, and runs part K. With more than one part, the last part runs
# only the other tests and MeasureTests (bin/lib/shard-plan). --shards is for
# CI. It prints a warning elsewhere unless --force-shards follows the count.
# bin/lib/swift-testing.sh sets the flags that swift needs to find Swift
# Testing.
# A run without --shards holds one machine-wide build slot (bin/lib/build-slot)
# for its build and its tests. A sharded run holds no slot itself. Its build
# and each of its shards take their own slot through bin/lib/swiftpm, so every
# swift test process that runs tests counts against the queue. A caller that
# already holds a slot runs them all inside it. Each swift build and swift test
# caps its compile jobs (bin/lib/swiftpm).
# SB_TEST_SLOTS sets how many integration tests, each with its own sbd, run at
# once in one swift test process. The default is 4, or one less than the CPU
# count when that is lower, and a value above one less than the CPU count
# counts as that (Tests/IntegrationTests/Blocking.swift). The cap applies to
# each process, so --shards N runs up to N times as many at once.
set -euo pipefail
cd "$(dirname "$0")/.."
# The run that waits for a slot prints the limits before it waits. It passes
# --limits-shown to the run inside the slot, which then skips the print.
if [ "${1:-}" = --limits-shown ]; then
  shift
else
  slots=$(bin/lib/build-slot --slots)
  jobs=$(bin/lib/swiftpm --jobs)
  [ "$slots" != 0 ] || slots=off
  [ "$jobs" != 0 ] || jobs="one per core"
  echo "bin/test: build slots: $slots, compile jobs: $jobs" >&2
fi
sharded= shard_part=1/1
if [ "${1:-}" = --shards ]; then
  shards_usage() { echo "usage: bin/test --shards N [--part K/P] [--force-shards]" >&2; exit 2; }
  [ $# -ge 2 ] || shards_usage
  sharded=1 shard_count=$2 forced=
  shift 2
  while [ $# -gt 0 ]; do
    case $1 in
    --part) [ $# -ge 2 ] || shards_usage; shard_part=$2; shift 2 ;;
    --force-shards) forced=1; shift ;;
    *) shards_usage ;;
    esac
  done
  [ "${CI:-}" = true ] || [ -n "$forced" ] ||
    echo "bin/test: warning: --shards is for CI. Run bin/test without it, or pass --force-shards after the count." >&2
else
  bin/lib/build-slot --check || exec bin/lib/build-slot -- "$PWD/bin/test" --limits-shown "$@"
fi
source bin/lib/swift-testing.sh
require_swift_testing
warn_if_tests_start_at_once
# Swift Testing starts every test at once. A test that blocks a thread, such
# as runCommand or starting sbd and tmux, holds one of the threads in Swift's
# cooperative pool, which has one per CPU. CI runners have 3 CPUs. A test with
# a time limit, such as ProcessTests, then waits for a thread behind the
# blocked ones, and its limit passes before it runs. This caps how many tests
# run at once, and leaves a thread free. Without the cap, those two tests timed
# out in 8 of 8 CI runs. Swift Testing reads the variable from Swift 6.3. The
# one in Xcode 26.0, Swift 6.2, ignores it and starts every test at once, so
# the integration suites also limit how many of their tests run at once
# (Tests/IntegrationTests/Blocking.swift). The other suites' time limits still
# fail under load there. bin/test warns about that Swift Testing
# (warn_if_tests_start_at_once). An existing value of the variable wins.
export SWT_EXPERIMENTAL_MAXIMUM_PARALLELIZATION_WIDTH="${SWT_EXPERIMENTAL_MAXIMUM_PARALLELIZATION_WIDTH:-2}"

# Each process caps how many tests run at once, so N processes run N times as
# many integration tests at once. Each process waits for its own build slot,
# so the queue decides how many of them run at once. Each process holds
# SwiftPM's lock on its build folder for the whole run, so each shard after the
# first runs from an APFS clone of .build.
shards() {
  local n=$1 clones=.build-shards
  # bin/lib/shard-plan checks the count too, but only after the build.
  [[ $n =~ ^[1-9][0-9]*$ ]] || { echo "bin/test: --shards needs a positive count" >&2; exit 2; }
  if ! [[ $2 =~ ^([1-9][0-9]*)/([1-9][0-9]*)$ ]] || [ "${BASH_REMATCH[1]}" -gt "${BASH_REMATCH[2]}" ]; then
    echo "bin/test: --part needs K/P with 1 <= K <= P, not '$2'" >&2
    exit 2
  fi
  local part=${BASH_REMATCH[1]} parts=${BASH_REMATCH[2]}
  build_tests
  local list total p i pattern plan patterns=()
  list=$(list_tests)
  plan=$(bin/lib/shard-plan "$n" "$parts" Tests/shard-weights <<<"$list")
  while read -r p i pattern; do
    if [ "$p" -eq "$part" ]; then patterns[i]=$pattern; fi
  done <<<"$plan"
  # shard-plan can leave a part with no suite. It has already checked that
  # every test matches one filter, so the other parts run every test.
  if [ "${#patterns[@]}" -eq 0 ]; then
    echo "bin/test: part $part of $parts has no tests to run" >&2
    exit 0
  fi
  total=$(grep -c -E "$(IFS='|'; echo "${patterns[*]}")" <<<"$list")
  rm -rf "$clones"
  mkdir "$clones"
  trap "rm -rf '$clones'" EXIT
  run_shard() {
    bin/lib/swiftpm test --skip-build --scratch-path "$2" --filter "${patterns[$1]}" 2>&1 |
      tee "$clones/$1.log" | awk -v p="[$1] " '{ print p $0; fflush() }'
  }
  local pids=() scratch
  for i in "${!patterns[@]}"; do
    [ "$i" -le "$n" ] || continue
    scratch=.build
    [ "${#pids[@]}" -eq 0 ] || scratch="$clones/$i"
    (if [ "$scratch" != .build ]; then cp -c -R .build "$scratch"; fi
      run_shard "$i" "$scratch") &
    pids[i]=$!
  done
  local status=0
  for i in "${!pids[@]}"; do
    wait "${pids[i]}" || status=$?
  done
  if [ -n "${patterns[n + 1]:-}" ]; then
    for _ in {1..36}; do
      sysctl -n vm.loadavg | awk -v c="$(sysctl -n hw.activecpu)" '{ exit !($2 > c) }' || break
      sleep 5
    done
    run_shard $((n + 1)) .build || status=$?
  fi
  local ran=0 count
  for i in "${!patterns[@]}"; do
    count=$(sed -n -E 's/.*Test run with ([0-9]+) tests?.*/\1/p' "$clones/$i.log" | tail -1) || count=
    ran=$((ran + ${count:-0}))
  done
  if [ "$status" -eq 0 ] && [ "$ran" -ne "$total" ]; then
    echo "bin/test: the shards ran $ran of $total tests" >&2
    status=1
  fi
  exit "$status"
}

if [ -n "$sharded" ]; then shards "$shard_count" "$shard_part"; fi
if [ "${1:-}" = --claude ]; then
  export SB_TEST_CLAUDE=1
  shift
  # The real tests rewrite the recordings that the stub tests play, so the
  # real tests run first, on their own.
  if [ $# -eq 0 ]; then
    status=0
    bin/lib/swiftpm test ${args[@]+"${args[@]}"} --filter ClaudeTests || status=$?
    bin/lib/swiftpm test ${args[@]+"${args[@]}"} --skip ClaudeTests || status=$?
    exit "$status"
  fi
fi

# Sets `json` to the text that swift package dump-package prints and
# `test_targets` to the package's test targets, one per line. Fails when it
# cannot read them.
read_package() {
  json=$(swift package dump-package) && jq -e .targets <<<"$json" >/dev/null 2>&1 &&
    test_targets=$(jq -r '.targets[] | select(.type == "test") | .name' <<<"$json")
}

# build_bundles <test-target>…
# Builds the named test targets' bundles and sets `built` to those targets, one
# per line. When a test target has no bundle of its own, it builds every bundle
# and sets `built` to every test target (test_bundles_exist). Reads
# `test_targets`, which read_package sets.
build_bundles() {
  if test_bundles_exist $test_targets; then
    built=$(printf '%s\n' "$@" | sort -u)
    build_test_bundles $built
  else
    echo "bin/test: a test target has no bundle of its own in the build folder, so every test bundle builds" >&2
    build_tests
    built=$test_targets
  fi
}

# Builds the bundles of the tests it selects and sets `run` to the swift test
# arguments that filter them to the selection. It never selects all of a
# ci-only target (bin/lib/test-selection.sh), which CI runs once the PR is
# ready. Exits when no test can read a changed file.
# A bundle that it does not build keeps its last build, which can predate the
# change, so every --filter must name a target whose bundle it built. The
# selection names every test target that depends on a changed target.
# test_filters can add smoke suites of a target that the selection did not
# name, so it then builds the bundles of those targets too. When a test target
# has no bundle of its own, it builds every bundle (test_bundles_exist).
targeted() {
  source bin/lib/test-selection.sh
  local base changed json test_targets selection filters filter target built missing
  if ! read_package; then
    for target in $ci_only_targets; do
      echo "bin/test: could not read the package's targets, so every test outside $target runs. CI runs $target once the PR is ready for review." >&2
      run+=(--skip "^$target\\.")
    done
    return
  fi
  if ! base=$(git merge-base origin/main HEAD 2>/dev/null); then
    echo "bin/test: no merge base with origin/main, so the unit test targets and the smoke suites run" >&2
    selection=$(fallback_selection "$json")
  else
    changed=$({ git diff --name-only --no-renames "$base"; git ls-files --others --exclude-standard; } | sort -u)
    selection=$(select_tests "$json" <<<"$changed")
  fi
  if [ -z "$selection" ]; then
    echo "bin/test: no test reads the files changed against origin/main. bin/test --all runs every test." >&2
    exit 0
  fi
  build_bundles $(selection_targets <<<"$selection")
  filters=$(test_filters <<<"$selection")
  missing=$(comm -13 <(sort <<<"$built") <(filter_targets <<<"$filters"))
  if [ -n "$missing" ]; then build_test_bundles $missing; fi
  run=(--skip-build)
  while IFS= read -r filter; do
    echo "bin/test: runs the tests that match $filter" >&2
    run+=(--filter "$filter")
  done <<<"$filters"
  echo "bin/test: CI runs every other test that the change can affect once the PR is ready for review, so a local run does not need them" >&2
}

# filter_bundles <arg>…
# Succeeds when the arguments are only --filter options and pattern_targets
# shows which test targets hold every test that they match, and those are not
# every test target. It then sets `targets` to them, one per line, and sets
# what read_package sets. Otherwise it fails, and swift test builds every test
# bundle in one build. Callers run it as a condition, which turns off set -e.
# So it checks each status itself.
filter_bundles() {
  local patterns=() pattern found
  while [ $# -gt 0 ]; do
    case $1 in
    --filter) [ $# -ge 2 ] || return 1; patterns+=("$2"); shift 2 ;;
    --filter=*) patterns+=("${1#--filter=}"); shift ;;
    *) return 1 ;;
    esac
  done
  source bin/lib/test-selection.sh
  if ! read_package; then
    echo "bin/test: could not read the package's targets, so every test bundle builds" >&2
    return 1
  fi
  targets=
  for pattern in "${patterns[@]}"; do
    if ! found=$(pattern_targets "$json" "$pattern") || [ -z "$found" ]; then
      echo "bin/test: could not tell which test bundles hold the tests that match $pattern, so every test bundle builds" >&2
      return 1
    fi
    targets+=${targets:+$'\n'}$found
  done
  targets=$(sort -u <<<"$targets")
  if [ "$targets" = "$(sort <<<"$test_targets")" ]; then
    echo "bin/test: every test bundle can hold tests that match the filters, so every test bundle builds" >&2
    return 1
  fi
}

# Builds only the bundles that can hold the tests that the --filter arguments
# match, and sets `run` to run without a build. It also skips every test of
# the other bundles, which can predate the change. Leaves `run` empty when
# filter_bundles fails.
filtered() {
  local target targets json test_targets built
  filter_bundles "$@" || return 0
  echo "bin/test: only the bundles of $(paste -sd' ' - <<<"$targets") can hold tests that match the filters" >&2
  build_bundles $targets
  run=(--skip-build)
  for target in $(comm -23 <(sort <<<"$test_targets") <(sort <<<"$built")); do
    run+=(--skip "^$target\\.")
  done
}

run=()
case ${1:-} in
--all) shift ;;
--changed)
  shift
  [ $# -eq 0 ] || { echo "usage: bin/test --changed" >&2; exit 2; }
  targeted
  ;;
"") targeted ;;
*) filtered "$@" ;;
esac
exec bin/lib/swiftpm test ${args[@]+"${args[@]}"} ${run[@]+"${run[@]}"} "$@"
