#!/usr/bin/env bash
# Runs the unit and integration tests. With --claude first, it also runs the
# tests that drive the installed claude with Haiku, which take minutes and use
# some of your Claude quota. The Command Line Tools' build system can leave out
# the folder that holds Swift Testing's macro plugin. This script passes that
# folder to the compiler when it exists.
set -euo pipefail
cd "$(dirname "$0")/.."
plugins="$(xcode-select -p)/usr/lib/swift/host/plugins/testing"
# Swift Testing starts every test at once. A test that blocks a thread, such
# as runCommand or starting sbd and tmux, holds one of the threads in Swift's
# cooperative pool, which has one per CPU. CI runners have 3 CPUs. A test with
# a time limit, such as ProcessTests, then waits for a thread behind the
# blocked ones, and its limit passes before it runs. This caps how many tests
# run at once, and leaves a thread free. Without the cap, those two tests timed
# out in 8 of 8 CI runs. Swift Testing reads the variable from Swift 6.3. The
# one in Xcode 26.0, Swift 6.2, ignores it and starts every test at once, so
# the integration suites also limit how many of their tests run at once
# (Tests/IntegrationTests/Blocking.swift). An existing value of the variable
# wins.
export SWT_EXPERIMENTAL_MAXIMUM_PARALLELIZATION_WIDTH="${SWT_EXPERIMENTAL_MAXIMUM_PARALLELIZATION_WIDTH:-2}"
args=()
if [ -d "$plugins" ]; then args=(-Xswiftc -plugin-path -Xswiftc "$plugins"); fi
if [ "${1:-}" = --claude ]; then
  export SB_TEST_CLAUDE=1
  shift
  # The real tests rewrite the recordings that the stub tests play, so the
  # real tests run first, on their own.
  if [ $# -eq 0 ]; then
    status=0
    swift test ${args[@]+"${args[@]}"} --filter ClaudeTests || status=$?
    swift test ${args[@]+"${args[@]}"} --skip ClaudeTests || status=$?
    exit "$status"
  fi
fi
exec swift test ${args[@]+"${args[@]}"} "$@"
