#!/usr/bin/env bash
# Runs the unit and integration tests. With --claude first, it also runs the
# tests that drive the installed claude with Haiku, which take minutes and use
# some of your Claude quota. With --shards N, it splits the tests across N
# swift test processes that run at once. The Command Line Tools' build system
# can leave out the folder that holds Swift Testing's macro plugin. This script
# passes that folder to the compiler when it exists.
set -euo pipefail
cd "$(dirname "$0")/.."
plugins="$(xcode-select -p)/usr/lib/swift/host/plugins/testing"
# Swift Testing starts every test at once. A test that blocks a thread, such
# as runCommand or starting sbd and tmux, holds one of the threads in Swift's
# cooperative pool, which has one per CPU. CI runners have 3 CPUs. A test with
# a time limit, such as ProcessTests, then waits for a thread behind the
# blocked ones, and its limit passes before it runs. This caps how many tests
# run at once, and leaves a thread free. Without the cap, those two tests timed
# out in 8 of 8 CI runs. The Command Line Tools' Swift Testing reads the
# variable. The one in Xcode 26.0 does not. An existing value of the variable
# wins.
export SWT_EXPERIMENTAL_MAXIMUM_PARALLELIZATION_WIDTH="${SWT_EXPERIMENTAL_MAXIMUM_PARALLELIZATION_WIDTH:-2}"
args=()
if [ -d "$plugins" ]; then args=(-Xswiftc -plugin-path -Xswiftc "$plugins"); fi

# Most of the run's time is integration tests that wait on sbd and tmux. Each
# process caps how many of them run at once, so N processes run N times as
# many. Each process holds SwiftPM's lock on its build folder for the whole
# run, so each shard after the first runs from an APFS clone of .build.
shards() {
  local n=$1 clones=.build-shards
  [[ $n =~ ^[1-9][0-9]*$ ]] || { echo "bin/test: --shards needs a positive count" >&2; exit 2; }
  swift build --build-tests ${args[@]+"${args[@]}"}
  local list
  list=$(swift test list --skip-build | grep /)
  local total
  total=$(grep -c . <<<"$list")
  # Each top-level suite goes to the shard with the fewest integration tests.
  # The other targets take seconds, so they weigh nothing.
  local plan
  plan=$(cut -d/ -f1 <<<"$list" | sort | uniq -c | sort -rn | awk -v n="$n" '
    { w = ($2 ~ /^IntegrationTests\./) ? $1 : 0
      best = 0
      for (i = 1; i < n; i++) if (load[i] < load[best]) best = i
      load[best] += w
      print best, $2 }')
  local i matched=0 patterns=()
  for ((i = 0; i < n; i++)); do
    local keys
    keys=$(awk -v i="$i" '$1 == i { gsub(/\./, "\\.", $2); printf "%s|", $2 }' <<<"$plan")
    [ -n "$keys" ] || continue
    patterns[i]="^(${keys%|})/"
    matched=$((matched + $(grep -c -E "${patterns[i]}" <<<"$list")))
  done
  if [ "$matched" -ne "$total" ]; then
    echo "bin/test: the shards' filters match $matched of $total tests" >&2
    exit 1
  fi
  rm -rf "$clones"
  trap 'rm -rf "$clones"' EXIT
  local pids=() logs=()
  for i in "${!patterns[@]}"; do
    local scratch=.build
    if [ "$i" -gt 0 ]; then
      scratch="$clones/$i"
      mkdir -p "$clones"
      cp -c -R .build "$scratch"
    fi
    logs[i]=$(mktemp)
    (set -o pipefail
      swift test --skip-build --scratch-path "$scratch" --filter "${patterns[i]}" 2>&1 |
        tee "${logs[i]}" | awk -v p="[$i] " '{ print p $0; fflush() }') &
    pids[i]=$!
  done
  local status=0 ran=0
  for i in "${!pids[@]}"; do
    wait "${pids[i]}" || status=$?
    local count
    count=$(sed -n -E 's/.*Test run with ([0-9]+) tests.*/\1/p' "${logs[i]}" | tail -1)
    ran=$((ran + ${count:-0}))
    rm -f "${logs[i]}"
  done
  if [ "$status" -eq 0 ] && [ "$ran" -ne "$total" ]; then
    echo "bin/test: the shards ran $ran of $total tests" >&2
    status=1
  fi
  exit "$status"
}

if [ "${1:-}" = --shards ]; then
  [ $# -eq 2 ] || { echo "usage: bin/test --shards N" >&2; exit 2; }
  shards "$2"
fi
if [ "${1:-}" = --claude ]; then
  export SB_TEST_CLAUDE=1
  shift
  # The real tests rewrite the recordings that the stub tests play, so the
  # real tests run first, on their own.
  if [ $# -eq 0 ]; then
    status=0
    swift test ${args[@]+"${args[@]}"} --filter ClaudeTests || status=$?
    swift test ${args[@]+"${args[@]}"} --skip ClaudeTests || status=$?
    exit "$status"
  fi
fi
exec swift test ${args[@]+"${args[@]}"} "$@"
