#!/bin/bash
# A stand-in for claude in sbd's integration tests. It runs the hook command
# from the settings file with the payloads that the real claude sent in the
# same step, from claude/<step>.jsonl next to this file, which the real
# claude tier records. Like claude, it turns on bracketed paste mode, so a
# paste that tmux wraps in ESC[200~ and ESC[201~ is one prompt with its new
# lines kept, and the next Enter submits it. Outside a paste, each line is a
# prompt. It answers each prompt:
#   ask ...          replies with a question
#   offer ...        replies with an offer of a next step
#   mode <name>      switches the permission mode to <name>, as Shift+Tab or
#                    an approved plan does, and replies "Mode: <name>". The
#                    turn's hooks report the new mode
#   slow <n>         runs a Bash tool call of n seconds, which SIGTERM ends.
#                    slow held runs one that lasts until $SB_HOME/report
#                    exists
#   run <name>       runs sh $SB_HOME/<name>.sh as a Bash tool call, a child
#                    of the stub, and replies "Ran <name>.". Without that
#                    file, it replies as to anything else
#   background <n> [held] [two]
#                    starts a background job of n seconds and ends the turn.
#                    With two, it starts a second job, whose pid goes to
#                    $SB_HOME/job2.pid, and reports after both exit.
#                    It reports the job in a turn of its own 0.5 s after the
#                    job's process exits. With held, the report also waits
#                    until $SB_HOME/report exists. The job's pid goes to
#                    $SB_HOME/job.pid
#   background <n> free
#                    starts the job as background does, but reports it from
#                    a subshell, so the stub reads the next prompt while the
#                    job runs, as claude does
#   interrupt ...    starts a tool call and stops, as Escape does. Claude
#                    Code sends no hook after Escape
#   fail ...         ends the turn with StopFailure, as an API error does.
#                    fail authentication_failed sends that error with the
#                    message of an expired login. Any other fail sends
#                    rate_limit
#   clear <uuid>     switches to another conversation, as /clear does
#   context <n>      writes an assistant line of model claude-test whose
#                    usage gives an input context of n tokens, as an API
#                    call does, then replies "Context: <n>". The reply's line
#                    carries no usage
#   linger <n>       waits n s after SIGTERM before it exits. A second
#                    SIGTERM does not restart the wait
#   lag ...          waits 1 s before it reports the prompt, which keeps the
#                    message in flight. lag held waits until
#                    $SB_HOME/report exists instead. While $SB_HOME/hold
#                    exists, every prompt waits as lag held does
#   onterm <file>    writes <file> in its folder first when SIGTERM arrives
#   perm <command>   asks permission to run a Bash command
#   edit <file> <old> <new>
#                    asks permission to replace <old> with <new> in <file>
#                    with the Edit tool, and replaces it after an allow
#   fetch <url>      asks permission to fetch <url> with the WebFetch tool.
#                    Its dialog offers only Yes and No
#   pick             asks two questions with AskUserQuestion, the second
#                    one multi-select
#   pick colors      asks only the multi-select question
#   pick fruit       asks only the single-choice question
#   For perm, edit, fetch, and pick, the PermissionRequest hook runs while a stand-in for
#   Claude Code's dialog shows on the terminal and reads keys: Enter on the
#   first item or y allows, and Escape, Enter on No, or esc refuses and kills
#   the hook, as Claude Code closes the request. timeout kills the hook and
#   leaves the dialog open, as the hook's timeout does. perm sleep <n> sleeps
#   n s before PostToolUse, as a long command does.
#   A permission dialog outside auto mode also offers "Yes, and switch to
#   auto mode", as Claude Code 2.1.318 does. Picking it, or a hook's allow
#   with a setMode, switches the mode. Each payload carries the mode, from
#   --permission-mode or `default`.
#   perm, edit, fetch, and pick build their tool payloads by hand. The stub does not play
#   permission.jsonl or question.jsonl yet.
#   mcp <name>       fetches that server's URL from the --mcp-config file and
#                    replies "MCP <name>: <answer>"
#   card <name>      pipes $SB_HOME/<name>.json into `sb summary set` before its
#                    Stop, as a session writes its Inbox card at the end of its
#                    turn. sb's output goes to $SB_HOME/summary-set.log
#   a prompt that holds "Switchboard plan artifact task." plays the chat's
#                    side of the task with a fake Artifact tool. See artifact
#   reply <name>     replies with the text of $SB_HOME/<name>.md
#   /compact ...     sends only SessionStart with source compact, as Claude
#                    Code runs a built-in command with no UserPromptSubmit
#                    and no turn
#   /<command> ...   replies "Done: <prompt>". Its UserPromptSubmit goes
#                    first, as Claude Code runs the hook before it writes the
#                    prompt to the transcript. A hook answer whose decision is
#                    block ends the turn there: no transcript line, no reply,
#                    and no Stop, as Claude Code 2.1.318 does. A prompt that
#                    holds " skill <name>" also calls the Skill tool for
#                    the text after its last " skill " in its turn, as a skill
#                    that loads another skill does, and replies "Denied:
#                    <reason>" when its PreToolUse hook denies the call
#   skill <name>     calls the Skill tool with {skill: <name>} and replies
#                    "Skill <name>", or "Denied: <reason>" when the
#                    PreToolUse hook answers a permissionDecision of deny. A
#                    deny sends no PostToolUse. A block of its
#                    UserPromptSubmit ends the turn as for /<command>
#   subskill <name>  does the same from a subagent, whose PreToolUse carries
#                    agent_id
#   anything else    replies "Done: <prompt>"
# `claude -p ...` is the summary call. It reads the prompt on stdin and prints
# the JSON that claude prints with --output-format json, with 100 input, 20
# output, 300 cache read, and 40 cache write tokens under the --model it got: a decision with two
# options for a reply that holds "Postgres or SQLite", an approval with one for
# "Want me to", and info otherwise. $SB_HOME/summary-answer.json, a fixture
# that the test writes, replaces that answer. A reply that holds FAIL-SUMMARY
# makes it exit 1, and SLOW-SUMMARY makes it hang. It appends the arguments to
# $SB_HOME/summary-calls.log, and keeps the last prompt in
# $SB_HOME/summary-input.txt.
# A `claude -p` prompt that holds <rows> is the plan update call instead. It
# prints $SB_HOME/plan-answer.json, a fixture that the test writes, as the
# structured output in the same envelope, or {"rows":[]} when the file is
# missing. It appends the arguments to $SB_HOME/plan-calls.log and not to
# summary-calls.log, and keeps the last prompt in $SB_HOME/plan-input.txt.
# A `claude -p` prompt that holds <pr-body> is the merge brief call. It
# prints $SB_HOME/pr-brief-answer.json, a fixture that the test writes, or
# {"summary":"It changes the code."} when the file is missing, in the same
# envelope. A prompt that holds FAIL-BRIEF makes it exit 1. It appends the
# arguments to $SB_HOME/pr-brief-calls.log and not to summary-calls.log, and
# keeps the last prompt in $SB_HOME/pr-brief-input.txt.
# A `claude -p` prompt whose first line is <session-name-request> is the
# session name call. It is checked first, because the prompt it carries can
# hold any tag below, but it can't come before that line. It writes each
# argument with a NUL after it to $SB_HOME/session-name-args, replacing that
# file, appends one line per call to $SB_HOME/session-name-calls.log, and
# keeps the last prompt in $SB_HOME/session-name-input.txt. A prompt that
# holds FAIL-NAME makes it exit 1, SLOW-NAME makes it exec sleep 30, and
# BAD-NAME answers {"name":"Fix The Bug!"}. Anything else answers with
# $SB_HOME/session-name-answer.json, else {"name":"stub-session-name"}, in
# the same envelope.
# A `claude -p` prompt in which <ci-log comes before any <session-reply> is
# the CI reader's judge call. It is checked first. Each judge's prompt escapes
# both tags in its data and names its own tag before the data, so the tag that
# comes first names the judge. It appends the --model it
# got as one line per call to $SB_HOME/ci-judge-calls.log, and keeps the last
# prompt in $SB_HOME/ci-judge-input.txt. A prompt that holds FAIL-CI-JUDGE
# makes it exit 1. Otherwise it prints $SB_HOME/ci-judge-answer.json, a
# fixture that the test writes, or
# {"cause":"real","message":"The tests failed."} when the file is missing, in
# the same envelope.
# A `claude -p` prompt that holds <session-reply> is the reply gate judge
# call. It is checked next, because a session's reply can hold any other
# tag. It appends the --model it got as one line per call to
# $SB_HOME/judge-calls.log, and keeps the last prompt in
# $SB_HOME/judge-input.txt. A prompt that holds FAIL-JUDGE makes it exit 1,
# and SLOW-JUDGE makes it exec sleep 30. Otherwise it prints
# $SB_HOME/judge-answer.json, a fixture that the test writes, or
# {"answer":"unsure","question":"","reason":"stub"} when the file is missing,
# in the same envelope. The default answer sends every merge question to the
# Operator, as it does without the judge.
# A `claude -p` prompt that holds <skill-file> is the skill classification
# call. It is checked next, because a skill file can hold any tag below. It
# writes each argument with a NUL after it to $SB_HOME/skill-classify-args,
# replacing that file, and writes $CLAUDE_CONFIG_DIR, or nothing when that
# variable is unset, to $SB_HOME/skill-classify-account. It appends the
# skill's name, the text between <skill-name> and </skill-name>, as one line
# per call to $SB_HOME/skill-classify-calls.log. It keeps the last prompt in
# $SB_HOME/skill-classify-input.txt, and writes $SB_SESSION_ID, or unset when
# that variable is unset, to $SB_HOME/skill-classify-session. A prompt that
# holds FAIL-SKILL makes it exit 1, and SLOW-SKILL makes it exec sleep 30.
# BAD-SKILL answers {"label":"maybe","reason":"x"}, LABEL-SAFE answers
# {"label":"safe","reason":"It reads notes."}, and anything else answers
# {"label":"work","reason":"It runs a pipeline."}, in the same envelope.
# A `claude -p` prompt that holds <switchboard-state> is the quick ask call.
# It is checked next, because the snapshot can hold <rows> or <pr-body>. It
# writes each argument with a NUL after it to $SB_HOME/quick-ask-args,
# replacing that file, so a test can split the last call's arguments exactly.
# It writes $CLAUDE_CONFIG_DIR to $SB_HOME/quick-ask-account. It appends one
# line per call to $SB_HOME/quick-ask-calls.log, keeps the last prompt in
# $SB_HOME/quick-ask-input.txt, and writes its pid to
# $SB_HOME/quick-ask.pid. A prompt that holds FAIL-ASK makes it exit 1, and
# SLOW-ASK makes it exec sleep 30, which keeps the pid. A prompt that holds
# ERROR-ASK makes it print an error envelope with the same token counts and
# exit 1, as claude does when the turn fails. Otherwise it prints
# $SB_HOME/quick-ask-answer.json, a fixture that the test writes, or
# {"answer":"Nothing needs you."} when the file is missing, in the same
# envelope.
# A `claude -p` prompt that holds <candidate ref=" is the top-up pick call.
# It is checked after the quick ask and before <rows> and <pr-body>, because
# an issue body can hold those tags. It appends the arguments to
# $SB_HOME/topup-calls.log and keeps the last prompt in
# $SB_HOME/topup-input.txt. A prompt that holds SLOW-TOPUP makes it exec
# sleep 30. Otherwise it prints $SB_HOME/topup-answer.json, a fixture that the
# test writes, or {"picks":[],"skips":[]} when the file is missing, in the
# same envelope.
# `claude agents ...` prints $CLAUDE_CONFIG_DIR/agents.json, a fixture that
# the test writes, or [] when it can't be read. It adds a row for each session
# that is in the middle of an interrupt or a slow tool call, which are the
# turns whose status the real claude reports as idle and busy.
# `claude mcp ...` stands for the lookup that makes the real claude refresh
# its OAuth token. When $CLAUDE_CONFIG_DIR/refreshed-credentials.json exists,
# a fixture that the test writes, it moves it over .credentials.json in the
# same folder. It prints nothing and exits 0.
# Like claude, it writes a line to the conversation's transcript for each
# prompt and for clear, at the transcript_path that the hook payloads name.
# Before the first prompt of each launch, it appends the lines of
# $SB_HOME/skill-listing.jsonl, a fixture that the test writes, as claude
# writes its initial skill listing then.
# --resume fails when no transcript exists, and --session-id fails when one
# does. Without CLAUDE_CONFIG_DIR, claude would use the user's ~/.claude, so
# the stub uses $SB_HOME/claude instead.
# While $SB_HOME/hold-start exists, it waits before SessionStart, as a claude
# that starts slowly does. SIGTERM then ends it with no hook.
# When $SB_HOME/start-linger holds n, SIGTERM before SessionStart ends it n s
# later with no hook, and it ignores a second SIGTERM.
# While $SB_HOME/ask-trust exists, it shows Claude Code's workspace trust
# dialog before SessionStart, unless the account's .claude.json trusts the
# folder. See trust_dialog.
# With STUB_HOOKS=off it runs no hooks, as when every hook fails.
# Each `claude -p` run appends its CLAUDE_CONFIG_DIR, empty when unset, with a
# NUL after it to $SB_HOME/headless-accounts.log before it reads the prompt's
# kind. A -p run does not go to stub-calls.log.
# Each run appends one record to $SB_HOME/stub-calls.log in one write:
# CLAUDE_CONFIG_DIR, SSH_AUTH_SOCK, CLAUDE_CODE_AUTO_COMPACT_WINDOW and the
# arguments, split by tabs. A NUL ends the record, because a prompt can hold
# a newline.
# What the hooks print goes to $SB_HOME/hook-output.log. See answer.
# Each decision that a PermissionRequest hook answers with goes to
# $SB_HOME/permission-answers.log. See answered.
# Each line it reads from the terminal goes to $SB_HOME/stub-input.log as it
# arrived, with the paste markers.

args=("$@")
# Prints the JSON that claude -p --output-format json prints for the structured output $1, with fixed token counts
# under the model that --model named, as claude reports them.
# Prints the --model that the call got, or haiku without one.
model() {
  local model=haiku i
  for ((i = 0; i < ${#args[@]}; i++)); do [ "${args[i]}" = --model ] && model=${args[i + 1]}; done
  echo "$model"
}
envelope() {
  jq -nc --argjson o "$1" --arg m "$(model)" '{type: "result", subtype: "success", is_error: false, result: ($o | tojson),
    structured_output: $o, usage: {input_tokens: 100, output_tokens: 20, cache_read_input_tokens: 300,
    cache_creation_input_tokens: 40}, modelUsage: {($m): {inputTokens: 100, outputTokens: 20,
    cacheReadInputTokens: 300, cacheCreationInputTokens: 40}}}'
}
if [ "${1-}" = -p ]; then
  input=$(cat)
  printf '%s\0' "${CLAUDE_CONFIG_DIR-}" >>"$SB_HOME/headless-accounts.log"
  if [[ $input == "<session-name-request>"* ]]; then
    printf '%s\0' "$@" >"$SB_HOME/session-name-args"
    echo "$$" >>"$SB_HOME/session-name-calls.log"
    printf '%s' "$input" >"$SB_HOME/session-name-input.txt"
    case $input in
    *FAIL-NAME*) echo "naming failed" >&2 && exit 1 ;;
    *SLOW-NAME*) exec sleep 30 ;;
    *BAD-NAME*) out='{"name":"Fix The Bug!"}' ;;
    *) out=$(cat "$SB_HOME/session-name-answer.json" 2>/dev/null) || out='{"name":"stub-session-name"}' ;;
    esac
    envelope "$out"
    exit 0
  fi
  # Each judge's prompt names its own tag before its data, so the tag that comes first decides.
  before_reply=${input%%"<session-reply>"*}
  if [[ $before_reply == *"<ci-log"* ]]; then
    model >>"$SB_HOME/ci-judge-calls.log"
    printf '%s' "$input" >"$SB_HOME/ci-judge-input.txt"
    [[ $input == *FAIL-CI-JUDGE* ]] && echo "CI judge failed" >&2 && exit 1
    out=$(cat "$SB_HOME/ci-judge-answer.json" 2>/dev/null) || out='{"cause":"real","message":"The tests failed."}'
    envelope "$out"
    exit 0
  fi
  # A session's reply can hold any of the tags below, so this check comes next.
  if [[ $input == *"<session-reply>"* ]]; then
    model >>"$SB_HOME/judge-calls.log"
    printf '%s' "$input" >"$SB_HOME/judge-input.txt"
    case $input in
    *FAIL-JUDGE*) echo "judge failed" >&2 && exit 1 ;;
    *SLOW-JUDGE*) exec sleep 30 ;;
    esac
    out=$(cat "$SB_HOME/judge-answer.json" 2>/dev/null) || out='{"answer":"unsure","question":"","reason":"stub"}'
    envelope "$out"
    exit 0
  fi
  # A skill file can hold any of the tags below, so this check comes next.
  if [[ $input == *"<skill-file>"* ]]; then
    printf '%s\0' "$@" >"$SB_HOME/skill-classify-args"
    printf '%s' "${CLAUDE_CONFIG_DIR-}" >"$SB_HOME/skill-classify-account"
    name=${input#*<skill-name>}
    name=${name%%</skill-name>*}
    printf '%s\n' "$name" >>"$SB_HOME/skill-classify-calls.log"
    printf '%s' "$input" >"$SB_HOME/skill-classify-input.txt"
    printf '%s' "${SB_SESSION_ID-unset}" >"$SB_HOME/skill-classify-session"
    case $input in
    *FAIL-SKILL*) echo "skill failed" >&2 && exit 1 ;;
    *SLOW-SKILL*) exec sleep 30 ;;
    *BAD-SKILL*) out='{"label":"maybe","reason":"x"}' ;;
    *LABEL-SAFE*) out='{"label":"safe","reason":"It reads notes."}' ;;
    *) out='{"label":"work","reason":"It runs a pipeline."}' ;;
    esac
    envelope "$out"
    exit 0
  fi
  # The quick ask's snapshot holds session text, which can hold <rows> or <pr-body>, so this check comes next.
  if [[ $input == *"<switchboard-state>"* ]]; then
    printf '%s\0' "$@" >"$SB_HOME/quick-ask-args"
    printf '%s' "${CLAUDE_CONFIG_DIR-}" >"$SB_HOME/quick-ask-account"
    echo "$$" >>"$SB_HOME/quick-ask-calls.log"
    printf '%s' "$input" >"$SB_HOME/quick-ask-input.txt"
    echo "$$" >"$SB_HOME/quick-ask.pid"
    case $input in
    *FAIL-ASK*) echo "ask failed" >&2 && exit 1 ;;
    *ERROR-ASK*)
      envelope '{}' | jq -c '.subtype = "error_during_execution" | .is_error = true | .result = "ask failed"
        | del(.structured_output)'
      exit 1
      ;;
    *SLOW-ASK*) exec sleep 30 ;;
    esac
    out=$(cat "$SB_HOME/quick-ask-answer.json" 2>/dev/null) || out='{"answer":"Nothing needs you."}'
    envelope "$out"
    exit 0
  fi
  # An issue body in the top-up's candidates can hold <rows> or <pr-body>, so this check comes before those.
  if [[ $input == *'<candidate ref="'* ]]; then
    printf '%s\0' "${args[*]}" >>"$SB_HOME/topup-calls.log"
    printf '%s' "$input" >"$SB_HOME/topup-input.txt"
    [[ $input == *SLOW-TOPUP* ]] && exec sleep 30
    # A test holds the pick on this FIFO while it changes sbd's sessions.
    if [ -p "$SB_HOME/topup-gate" ]; then read -r _ <"$SB_HOME/topup-gate"; fi
    out=$(cat "$SB_HOME/topup-answer.json" 2>/dev/null) || out='{"picks":[],"skips":[]}'
    envelope "$out"
    exit 0
  fi
  if [[ $input == *"<rows>"* ]]; then
    printf '%s\0' "${args[*]}" >>"$SB_HOME/plan-calls.log"
    printf '%s' "$input" >"$SB_HOME/plan-input.txt"
    out=$(cat "$SB_HOME/plan-answer.json" 2>/dev/null) || out='{"rows":[]}'
    envelope "$out"
    exit 0
  fi
  if [[ $input == *"<pr-body>"* ]]; then
    printf '%s\0' "${args[*]}" >>"$SB_HOME/pr-brief-calls.log"
    printf '%s' "$input" >"$SB_HOME/pr-brief-input.txt"
    [[ $input == *FAIL-BRIEF* ]] && echo "brief failed" >&2 && exit 1
    out=$(cat "$SB_HOME/pr-brief-answer.json" 2>/dev/null) || out='{"summary":"It changes the code."}'
    envelope "$out"
    exit 0
  fi
  printf '%s\0' "${args[*]}" >>"$SB_HOME/summary-calls.log"
  printf '%s' "$input" >"$SB_HOME/summary-input.txt"
  case $input in
  *FAIL-SUMMARY*) echo "summary failed" >&2 && exit 1 ;;
  *SLOW-SUMMARY*) exec sleep 30 ;;
  esac
  reply=${input#*<reply>}
  reply=${reply%</reply>*}
  case $reply in
  *"Postgres or SQLite"*)
    out='{"title":"Pick a database","kind":"decision","summary":"It asks which database to use.","options":[{"label":"Postgres","detail":"Already in use","message":"Use Postgres.","recommended":true},{"label":"SQLite","message":"Use SQLite."}]}'
    ;;
  *"Want me to"*)
    out='{"title":"Run the tests","kind":"approval","summary":"It wrote the parser and offers to run the tests.","options":[{"label":"Run the tests","message":"Yes, run the tests.","recommended":true}]}'
    ;;
  *) out='{"title":"Read the reply","kind":"info","summary":"It finished.","options":[]}' ;;
  esac
  [ -f "$SB_HOME/summary-answer.json" ] && out=$(cat "$SB_HOME/summary-answer.json")
  envelope "$out"
  exit 0
fi
printf '%s\t%s\t%s\t%s\0' "${CLAUDE_CONFIG_DIR-}" "${SSH_AUTH_SOCK-}" "${CLAUDE_CODE_AUTO_COMPACT_WINDOW-}" "${args[*]}" \
  >>"$SB_HOME/stub-calls.log"
if [ "${1-}" = agents ]; then
  listed=$(cat "${CLAUDE_CONFIG_DIR-}/agents.json" 2>/dev/null || echo '[]')
  rows=("${CLAUDE_CONFIG_DIR:-$SB_HOME/claude}"/status/*)
  if [ -e "${rows[0]}" ]; then
    jq -c --slurpfile r <(cat "${rows[@]}") '. + $r' <<<"$listed"
  else
    echo "$listed"
  fi
  exit 0
fi
if [ "${1-}" = mcp ]; then
  dir=${CLAUDE_CONFIG_DIR:-$SB_HOME/claude}
  [ -e "$dir/refreshed-credentials.json" ] && mv "$dir/refreshed-credentials.json" "$dir/.credentials.json"
  exit 0
fi
config_dir=${CLAUDE_CONFIG_DIR:-$SB_HOME/claude}
# Claude names a project's folder after its cwd, as emit fills {{encoded_cwd}}. `folder` copies
# ClaudeFolder.name. It counts code points where claude counts UTF-16 units, and it doesn't normalize
# to NFC. So it matches only for NFC paths without characters outside the BMP.
folder_jq='
  def b36: if . == 0 then "0" else [recurse(if . >= 36 then (. / 36 | floor) else empty end) | . % 36]
    | reverse | map("0123456789abcdefghijklmnopqrstuvwxyz"[.:.+1]) | add end;
  def jhash: reduce explode[] as $c (0; (. * 31 + $c) % 4294967296)
    | if . >= 2147483648 then 4294967296 - . else . end;
  def folder: gsub("[^A-Za-z0-9]"; "-") as $n
    | if ($n | length) > 200 then "\($n[:200])-\(jhash | b36)" else $n end;'
project="$config_dir/projects/$(jq -rn --arg c "$PWD" "$folder_jq"' $c | folder')"

recordings="$(dirname "$0")/claude"
settings='' mcp_config='' session='' prompt='' source=startup linger=0 onterm='' mode=default listed=''
while [ $# -gt 0 ]; do
  case $1 in
  --settings) settings=$2 && shift 2 ;;
  --mcp-config) mcp_config=$2 && shift 2 ;;
  --session-id) session=$2 && shift 2 ;;
  --resume) session=$2 source=resume && shift 2 ;;
  --permission-mode) mode=$2 && shift 2 ;;
  --model | --append-system-prompt) shift 2 ;;
  --) prompt=${2:-} && break ;;
  --*) shift ;;
  *) prompt=$1 && shift ;;
  esac
done
# The mode lives in a file, because a dialog's answer arrives in a subshell.
mode_file="$SB_HOME/stub-mode.$$"
printf '%s' "$mode" >"$mode_file"
hook_cmd=$(jq -r '.hooks.Stop[0].hooks[0].command' "$settings")
sb_cmd=${hook_cmd% hook}
request_cmd=$(jq -r '.hooks.PermissionRequest[0].hooks[0].command' "$settings")

# payload <event> [json fields]: a hook payload shaped like claude's. It names
# the transcript, as claude's does, even before the file exists.
payload() {
  jq -nc --arg e "$1" --arg s "$session" --arg t "$project/$session.jsonl" --arg m "$(<"$mode_file")" --argjson f "${2:-{\}}" \
    '{hook_event_name: $e, session_id: $s, transcript_path: $t, permission_mode: $m} + $f'
}

# transcript <text>: appends a line to the conversation's transcript.
transcript() {
  mkdir -p "$project"
  jq -nc --arg t "$1" '{type: "user", message: {role: "user", content: $t}}' >>"$project/$session.jsonl"
}

# status <idle|busy>: what `claude agents` reports for this session, or
# nothing without an argument.
status() {
  mkdir -p "$config_dir/status"
  if [ -n "${1-}" ]; then
    jq -nc --arg s "$session" --arg c "$PWD" --arg t "$1" --argjson p $$ \
      '{sessionId: $s, cwd: $c, status: $t, pid: $p}' >"$config_dir/status/.$session" &&
      mv "$config_dir/status/.$session" "$config_dir/status/$session"
  else
    rm -f "$config_dir/status/$session"
  fi
}

# reply_line <text>: appends the assistant's reply to the transcript.
reply_line() {
  mkdir -p "$project"
  jq -nc --arg t "$1" \
    '{type: "assistant", message: {role: "assistant", content: [{type: "text", text: $t}]}}' >>"$project/$session.jsonl"
}

# usage_line <n>: appends an assistant line whose usage gives an input context of n tokens.
usage_line() {
  mkdir -p "$project"
  jq -nc --argjson n "$1" \
    '{type: "assistant", message: {model: "claude-test", role: "assistant", content: [],
      usage: {input_tokens: 1, cache_creation_input_tokens: 0, cache_read_input_tokens: ($n - 1), output_tokens: 5}}}' \
    >>"$project/$session.jsonl"
}

# hook <event> [json fields]
hook() {
  [ "${STUB_HOOKS-}" = off ] && return 0
  payload "$@" | sh -c "$hook_cmd" >/dev/null
}

rule=────────────────────────────────────────

# draw <cursor>: prints the dialog with ❯ on item <cursor>, as Claude Code
# draws it: a rule, the head lines, the menu, and a footer that offers Esc.
# A caller can set $footer to replace the footer's text.
# It goes to stderr, because a caller captures stdout.
draw() {
  local i=0 item
  {
    printf '%s\n' "$rule" "${head[@]}"
    for item in "${items[@]}"; do
      [ "$i" = "$1" ] && printf ' ❯ %s\n' "$item" || printf '   %s\n' "$item"
      i=$((i + 1))
    done
    printf ' %s\n' "${footer:-Esc to cancel}"
  } >&2
}

# erase: removes the dialog that draw printed.
erase() { printf '\033[%dA\033[J' $((${#head[@]} + ${#items[@]} + 2)) >&2; }

# keys <drawn>: draws the dialog, or draws it again when <drawn> is 1, then
# reads keys from the terminal until an answer, and writes the answer to
# $term. Up and Down move the cursor. Enter answers with the typed word, or
# with the highlighted item: y for the first, auto for the auto mode item,
# and esc for No. Escape alone answers esc. bash 3.2 reads with whole-second
# timeouts, so a lone Escape takes 1 s.
keys() {
  local c rest word='' cursor=0
  [ "$1" = 1 ] && erase
  draw 0
  while IFS= read -r -s -n1 -u 3 c; do
    case $c in
    $'\e')
      rest=''
      IFS= read -r -s -n2 -t 1 -u 3 rest
      case $rest in
      '[A' | OA) [ "$cursor" -gt 0 ] && cursor=$((cursor - 1)) ;;
      '[B' | OB) [ "$cursor" -lt $((${#items[@]} - 1)) ] && cursor=$((cursor + 1)) ;;
      *) word=esc && break ;;
      esac
      erase
      draw "$cursor"
      ;;
    '')
      if [ -z "$word" ]; then
        case ${items[$cursor]} in
        *". No") word=esc ;;
        *"switch to auto mode"*) word=auto ;;
        *) word=y ;;
        esac
      fi
      break
      ;;
    *) word="$word$c" ;;
    esac
  done
  [ -n "$word" ] && printf '%s\n' "$word" >"$term"
}

# dialog <fields>: runs the PermissionRequest hook while the terminal's dialog
# waits for keys, and prints the first answer: "hook <output>" or
# "terminal <word>". A hook that prints nothing made no decision, so the
# dialog keeps waiting. It prints nothing when the terminal closes, as when
# the pane dies. The hook's pid goes to $SB_HOME/held-hook.pid. The dialog
# shows the command, or the first question and its options. When
# $SB_HOME/suggestions.json exists, the request carries its JSON as
# permission_suggestions.
dialog() {
  local fields=$1
  if [ -f "$SB_HOME/suggestions.json" ]; then
    fields=$(jq -c --slurpfile s "$SB_HOME/suggestions.json" '. + {permission_suggestions: $s[0]}' <<<"$fields")
  fi
  local out term hook_pid reader_pid open said answer='' tool head items
  out=$(mktemp) term=$(mktemp)
  tool=$(jq -r .tool_name <<<"$1")
  if [ "$tool" = AskUserQuestion ]; then
    echo "⏺ AskUserQuestion" >&2
    head=("←  ☐ $(jq -r '[.tool_input.questions[].header] | join("  ☐ ")' <<<"$1")  ✔ Submit  →"
      "$(jq -r '.tool_input.questions[0].question' <<<"$1")")
    items=()
    while IFS= read -r line; do items+=("$line"); done < <(jq -r '.tool_input.questions[0].options | to_entries[] | "\(.key + 1). \(.value.label)"' <<<"$1")
  elif [ "$tool" = Edit ]; then
    local file shown
    file=$(jq -r .tool_input.file_path <<<"$1")
    shown=${file#"$PWD/"}
    echo "⏺ Update($shown)" >&2
    head=(" Edit file" " $shown" "╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌" " 1 -$(jq -r .tool_input.old_string <<<"$1")"
      " 1 +$(jq -r .tool_input.new_string <<<"$1")" "╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌" " Do you want to make this edit to ${file##*/}?")
    items=("1. Yes" "2. Yes, and switch to accept edits (auto-approve file edits and common file commands) for this session (shift+tab)" "3. No")
  elif [ "$tool" = WebFetch ]; then
    local url
    url=$(jq -r .tool_input.url <<<"$1")
    echo "⏺ Fetch($url)" >&2
    head=(" Fetch" " $url" " Do you want to allow Claude to fetch this content?")
    items=("1. Yes" "2. No")
  else
    echo "⏺ $tool($(jq -r .tool_input.command <<<"$1"))" >&2
    head=(" Bash command" "╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌" " $(jq -r .tool_input.command <<<"$1")" "╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌"
      " Do you want to proceed?")
    if [ "$(<"$mode_file")" = auto ]; then
      items=("1. Yes" "2. No")
    else
      items=("1. Yes" "2. Yes, and switch to auto mode · auto mode handles these prompts for you" "3. No")
    fi
  fi
  stty -icanon -echo <&3
  payload PermissionRequest "$(jq -c --arg c "$PWD" '. + {cwd: $c}' <<<"$fields")" | sh -c "exec $request_cmd" >"$out" &
  hook_pid=$!
  echo "$hook_pid" >"$SB_HOME/held-hook.pid"
  keys 0 &
  reader_pid=$!
  while [ -z "$answer" ]; do
    if [ -n "$hook_pid" ] && ! kill -0 "$hook_pid" 2>/dev/null; then
      [ -s "$out" ] && answer="hook $(cat "$out")"
      hook_pid=''
    fi
    # The reader exits without an answer when the terminal closes. The check
    # comes before the read, so an answer that the reader wrote before it
    # exited still counts.
    kill -0 "$reader_pid" 2>/dev/null && open=1 || open=''
    # One read per pass, so an answer that arrives mid-pass waits for the next.
    said=$(cat "$term")
    if [ -z "$answer" ] && [ -z "$open" ] && [ -z "$said" ]; then
      break
    elif [ -z "$answer" ] && [ "$said" = timeout ]; then
      [ -n "$hook_pid" ] && kill "$hook_pid"
      : >"$term"
      keys 1 &
      reader_pid=$!
    elif [ -z "$answer" ] && [ -n "$said" ]; then
      answer="terminal $said"
    fi
    sleep 0.1
  done
  kill "$reader_pid" 2>/dev/null
  wait "$reader_pid" 2>/dev/null
  [ -n "$answer" ] && erase
  stty icanon echo <&3
  case $answer in "terminal esc" | '') [ -n "$hook_pid" ] && kill "$hook_pid" ;; esac
  rm -f "$out" "$term"
  printf '%s' "$answer"
}

# trust_dialog: Claude Code's workspace trust dialog, which shows before
# SessionStart in a folder whose real path the account's .claude.json does
# not trust. Its lines are shorter than the pane, so erase can count them.
# It highlights "No, exit" first. Enter on "Yes, I trust this
# folder" returns. Enter on "No, exit", a lone Escape, or a closed terminal
# exits with no hook. It writes no trust, so a test can tell sbd's write
# from claude's.
trust_dialog() {
  local c rest cursor=0 trusted='' head items footer="Enter to confirm · Esc to cancel"
  trust_head
  items=("No, exit" "Yes, I trust this folder")
  stty -icanon -echo
  draw 0
  while IFS= read -r -s -n1 c; do
    case $c in
    $'\e')
      rest=''
      IFS= read -r -s -n2 -t 1 rest
      case $rest in
      '[A' | OA) cursor=0 ;;
      '[B' | OB) cursor=1 ;;
      *) break ;;
      esac
      erase
      trust_head
      draw "$cursor"
      ;;
    '')
      [ "$cursor" = 1 ] && trusted=1
      break
      ;;
    esac
  done
  [ -n "$trusted" ] || exit 0
  erase
  stty icanon echo
}

# trust_head: the trust dialog's lines above its menu. The folder is the
# text of $SB_HOME/trust-folder while that file exists, so a test can make
# the dialog name another folder than the card's.
trust_head() {
  local folder
  folder=$(cat "$SB_HOME/trust-folder" 2>/dev/null) || folder=$(pwd -P)
  head=(" Accessing workspace:" "" " $folder" ""
    " Quick safety check: Is this a project you created or one you trust?"
    " (Like your own code, a well-known open source project, or work from"
    " your team). If not, take a moment to review what's in this folder first."
    "" " Claude Code'll be able to read, edit, and execute files here." "" " Security guide" "")
}

# vars <prompt> <reply> [command]: the values that fill a step's placeholders.
vars() {
  jq -nc --arg p "$1" --arg r "$2" --arg c "${3:-}" '{prompt: $p, reply: $r, command: $c, description: $p}'
}

# answer <output>: handles what a hook printed. It appends the conversation's
# id, a tab, and the output to $SB_HOME/hook-output.log, with a NUL after it.
# It writes an additionalContext to the transcript as the attachment line
# that Claude Code 2.1.318 writes.
answer() {
  # gated reads the last answer. It is set only when the hook runs in this shell, not in a pipeline's subshell.
  last_answer=$1
  [ -z "$1" ] && return
  printf '%s\t%s\0' "$session" "$1" >>"$SB_HOME/hook-output.log"
  local context
  context=$(jq -r '.hookSpecificOutput.additionalContext // empty' <<<"$1" 2>/dev/null)
  [ -z "$context" ] && return
  mkdir -p "$project"
  jq -nc --arg c "$context" --arg e "$(jq -r .hookSpecificOutput.hookEventName <<<"$1")" \
    '{type: "attachment", attachment: {type: "hook_additional_context", content: [$c], hookEvent: $e}}' \
    >>"$project/$session.jsonl"
}

# emit [vars] [<text> <command>]: runs the hook command with each payload on
# stdin, and runs the shell command before the first payload that contains
# the text. Each {{name}} takes its value from the vars, or from this session for
# its id and folders. The Claude config folder is $config_dir, and the
# folders that claude keeps in /tmp move into $SB_HOME. The loop runs in this shell and
# not in a pipeline's subshell, so a SIGKILL also stops the hooks that remain.
emit() {
  local extra=${1:-'{}'} payload paused='' payloads
  payloads=$(jq -c --arg s "$session" --arg cwd "$PWD" --arg home "$SB_HOME" --arg config "$config_dir" --arg mode "$(<"$mode_file")" --argjson extra "$extra" "$folder_jq"'
    ({session_id: $s, cwd: $cwd, encoded_cwd: ($cwd | folder), config_dir: $config,
      claude_tmp: "\($home)/tmp", home: env.HOME} + $extra) as $v
    | walk(if type == "string" then
        reduce ($v | to_entries[]) as $e (.; gsub("\\{\\{\($e.key)\\}\\}"; $e.value))
      else . end)
    | if has("permission_mode") then .permission_mode = $mode else . end')
  while IFS= read -r payload; do
    [ -z "$payload" ] && continue
    if [ -n "${2:-}" ] && [ -z "$paused" ] && [[ $payload == *"$2"* ]]; then
      eval "$3"
      paused=1
    fi
    [ "${STUB_HOOKS-}" = off ] || answer "$(printf '%s\n' "$payload" | sh -c "$hook_cmd")"
  done <<<"$payloads"
}

# play <step> [vars] [<text> <command>]: emits each payload of the recorded step.
play() {
  local step=$1
  shift
  emit "$@" <"$recordings/$step.jsonl"
}

# event <step> <event>: the payloads of one hook event in the recorded step.
event() { jq -c --arg e "$2" 'select(.hook_event_name == $e)' "$recordings/$1.jsonl"; }

# answered <tool> <input> <answer> [terminal input]: finishes a call that
# dialog answered. It prints the reply, or nothing when the turn stopped or
# the terminal closed. A hook's decision goes to
# $SB_HOME/permission-answers.log as the conversation's id, a tab, and the
# decision's JSON, with a NUL after it.
answered() {
  local tool=$1 input=$2 answer=$3 decision cmd
  case $answer in
  '') return ;;
  "terminal y")
    input=${4:-$input}
    ;;
  "terminal auto")
    printf auto >"$mode_file"
    ;;
  "terminal esc")
    stopped
    return
    ;;
  hook*)
    decision=$(printf '%s' "${answer#hook }" | jq -c .hookSpecificOutput.decision)
    printf '%s\t%s\0' "$session" "$decision" >>"$SB_HOME/permission-answers.log"
    case $(jq -r .behavior <<<"$decision") in
    allow)
      input=$(jq -c --argjson i "$input" '.updatedInput // $i' <<<"$decision")
      jq -r --arg m "$(<"$mode_file")" '[.updatedPermissions[]? | select(.type == "setMode") | .mode] | last // $m' \
        <<<"$decision" >"$mode_file.new" && mv "$mode_file.new" "$mode_file"
      ;;
    deny)
      if [ "$(jq -r .interrupt <<<"$decision")" = true ]; then
        stopped
      elif [ "$tool" = AskUserQuestion ]; then
        echo "Waiting for your answer."
      else
        echo "Denied: $(jq -r .message <<<"$decision")"
      fi
      return
      ;;
    esac
    ;;
  esac
  # A long command delays PostToolUse.
  cmd=$(jq -r '.command // ""' <<<"$input")
  case $cmd in sleep\ *) eval "$cmd" ;; esac
  hook PostToolUse "$(jq -nc --arg t "$tool" --argjson i "$input" '{tool_name: $t, tool_use_id: "c1", tool_input: $i}')"
  if [ "$tool" = AskUserQuestion ]; then
    echo "Picked: $(jq -cS .answers <<<"$input")"
  elif [ "$tool" = Edit ]; then
    local file old new text
    file=$(jq -r .file_path <<<"$input") old=$(jq -r .old_string <<<"$input") new=$(jq -r .new_string <<<"$input")
    text=$(<"$file")
    # bash 3.2 keeps the quotes of a quoted replacement.
    text=${text/"$old"/$new}
    printf '%s\n' "$text" >"$file"
    echo "Edited $file"
  elif [ "$tool" = WebFetch ]; then
    echo "Fetched $(jq -r .url <<<"$input")"
  else
    echo "Ran $(jq -r .command <<<"$input")"
  fi
}

# call_tool <tool> <input> [input after a pick in the terminal]: runs a call
# that needs permission, and prints the reply, or nothing when the turn
# stopped. Like claude, it writes the call's tool_use line to the transcript
# before PreToolUse.
call_tool() {
  local fields
  fields=$(jq -nc --arg t "$1" --argjson i "$2" '{tool_name: $t, tool_input: $i}')
  mkdir -p "$project"
  jq -nc --arg t "$1" --argjson i "$2" \
    '{type: "assistant", message: {role: "assistant", content: [{type: "tool_use", id: "c1", name: $t, input: $i}]}}' \
    >>"$project/$session.jsonl"
  hook PreToolUse "$(jq -c '. + {tool_use_id: "c1"}' <<<"$fields")"
  answered "$1" "$2" "$(dialog "$fields")" "${3:-}"
}

# stopped: ends the turn without a Stop or any other hook, as Escape does at a
# permission dialog and as a hook's deny with interrupt does. sbd finds out
# from `claude agents`.
stopped() {
  echo "⏺ Interrupted" >&2
  status idle
}

# asks <prompt> <tool> <input> [input after a pick in the terminal]: plays
# the recorded turn around a call that needs permission. The turn has no Stop
# when the call stopped it.
asks() {
  local reply
  event turn UserPromptSubmit | emit "$(vars "$1" "")"
  reply=$(call_tool "${@:2}")
  [ -z "$reply" ] && return
  echo "⏺ $reply"
  reply_line "$reply"
  event turn Stop | emit "$(vars "$1" "$reply")"
}

# skill_call <name> [agent]: calls the Skill tool for <name>, from the
# subagent <agent> when it is given, and prints "Denied: <reason>" when the
# PreToolUse hook denies the call, or nothing when it allows it. Like claude,
# it writes the call's tool_use line to the transcript before PreToolUse, and
# it sends PostToolUse only for a call that ran.
skill_call() {
  local fields
  fields=$(jq -nc --arg n "$1" '{tool_name: "Skill", tool_input: {skill: $n}, tool_use_id: "s1"}')
  [ -n "${2:-}" ] && fields=$(jq -c --arg a "$2" '. + {agent_id: $a, agent_type: "general-purpose"}' <<<"$fields")
  mkdir -p "$project"
  jq -nc --arg n "$1" \
    '{type: "assistant", message: {role: "assistant", content: [{type: "tool_use", id: "s1", name: "Skill", input: {skill: $n}}]}}' \
    >>"$project/$session.jsonl"
  last_answer=''
  [ "${STUB_HOOKS-}" = off ] || answer "$(payload PreToolUse "$fields" | sh -c "$hook_cmd")"
  if [ "$(jq -r '.hookSpecificOutput.permissionDecision // empty' <<<"$last_answer" 2>/dev/null)" = deny ]; then
    echo "Denied: $(jq -r '.hookSpecificOutput.permissionDecisionReason // ""' <<<"$last_answer")"
    return
  fi
  hook PostToolUse "$(jq -c '. + {tool_response: {success: true}}' <<<"$fields")"
}

# gated <prompt>: plays a turn of a prompt that sbd's hooks may refuse: a
# /<command>, skill <name>, or subskill <name>. See the list at the top.
gated() {
  local p=$1 reply denied
  last_answer=''
  emit "$(vars "$p" "")" < <(event turn UserPromptSubmit)
  if [ "$(jq -r '.decision // empty' <<<"$last_answer" 2>/dev/null)" = block ]; then
    printf 'UserPromptSubmit operation blocked by hook:\n%s\n' "$(jq -r '.reason // ""' <<<"$last_answer")"
    status
    return
  fi
  transcript "$p"
  status
  case $p in
  skill\ *)
    denied=$(skill_call "${p#skill }")
    reply=${denied:-"Skill ${p#skill }"}
    ;;
  subskill\ *)
    denied=$(skill_call "${p#subskill }" sub1)
    reply=${denied:-"Skill ${p#subskill }"}
    ;;
  *\ skill\ *)
    denied=$(skill_call "${p##* skill }")
    reply=${denied:-"Done: $p"}
    ;;
  *) reply="Done: $p" ;;
  esac
  echo "⏺ $reply"
  reply_line "$reply"
  emit "$(vars "$p" "$reply")" < <(event turn Stop)
  status
}

# artifact <prompt>: plays a Switchboard plan artifact task with a fake
# Artifact tool, and prints the reply. The artifact whose URL ends in <id> is
# the text in $SB_HOME/artifacts/<id>, and its version is the text in
# <id>.version, which may be missing. It reports each result with
# `sb plan artifact report`, where sb is the command of the switchboard server
# in --mcp-config. read saves the text to a file and reports read. rewrite
# copies copy: to write:, inserts " updated" before the last | of each row:
# line, and reports proposal. publish reports check with the artifact's text
# and version, and stops when that report fails. Otherwise it writes
# publish: over the artifact, increments an integer version or appends +1 to
# any other one, and reports published with the new version.
artifact() {
  local line plan='' url='' task='' copy='' write='' publish='' rows=() cfg sb store version=() new out
  while IFS= read -r line; do
    line=${line%$'\r'}
    case $line in
    plan:\ *) plan=${line#plan: } ;;
    artifact:\ *) url=${line#artifact: } ;;
    task:\ *) task=${line#task: } ;;
    copy:\ *) copy=${line#copy: } ;;
    write:\ *) write=${line#write: } ;;
    publish:\ *) publish=${line#publish: } ;;
    row:\ *) rows+=("${line#row: }") ;;
    # A blank line ends the machine lines.
    '') [ -n "$task" ] && break ;;
    esac
  done <<<"${1#*Switchboard plan artifact task.}"
  # A chat's --mcp-config is inline JSON. The Manager's is a file.
  [[ $mcp_config == \{* ]] && cfg=$mcp_config || cfg=$(cat "$mcp_config" 2>/dev/null)
  sb=$(jq -r '.mcpServers.switchboard.command // empty' <<<"$cfg")
  [ -z "$sb" ] && echo "Artifact $task: no switchboard server" && return
  store="$SB_HOME/artifacts/${url##*/}"
  [ -f "$store.version" ] && version=(--version "$(cat "$store.version")")
  case $task in
  read)
    [ -f "$store" ] || { echo "Artifact read: no artifact at $url" && return; }
    cp "$store" "$PWD/artifact-read.md"
    out=$("$sb" plan artifact report "$plan" --kind read --file "$PWD/artifact-read.md" "${version[@]}" 2>&1) ||
      { echo "Artifact read: the report failed: $(oneline "$out")" && return; }
    echo "Artifact read: reported $url"
    ;;
  rewrite)
    perl -e '
      my ($from, $to, @rows) = @ARGV;
      my %named = map { $_ => 1 } @rows;
      open(my $in, "<", $from) or die "$from: $!";
      open(my $out, ">", $to) or die "$to: $!";
      while (my $l = <$in>) {
        my ($body, $end) = $l =~ /^(.*?)(\r?\n?)\z/s;
        (my $t = $body) =~ s/^\s+|\s+$//g;
        $body =~ s/\s*\|\s*$/ updated |/ if $named{$t};
        print $out $body . $end;
      }' "$copy" "$write" "${rows[@]}"
    out=$("$sb" plan artifact report "$plan" --kind proposal --file "$(absolute "$write")" 2>&1) ||
      { echo "Artifact rewrite: the report failed: $(oneline "$out")" && return; }
    echo "Artifact rewrite: proposed $write"
    ;;
  publish)
    [ -f "$store" ] && cp "$store" "$PWD/artifact-check.md" || : >"$PWD/artifact-check.md"
    out=$("$sb" plan artifact report "$plan" --kind check --file "$PWD/artifact-check.md" "${version[@]}" 2>&1) ||
      { echo "Artifact publish: stopped: $(oneline "$out")" && return; }
    new=${version[1]-}
    if [[ $new =~ ^[0-9]+$ ]]; then new=$((new + 1)); elif [ -n "$new" ]; then new="$new+1"; else new=1; fi
    cp "$publish" "$store"
    printf '%s' "$new" >"$store.version"
    out=$("$sb" plan artifact report "$plan" --kind published --version "$new" 2>&1) ||
      { echo "Artifact publish: published, and the report failed: $(oneline "$out")" && return; }
    echo "Artifact publish: published $url version $new"
    ;;
  *) echo "Artifact: no task $task" ;;
  esac
}

# absolute <path>: the path, relative to the cwd unless it starts with /.
absolute() { [[ $1 == /* ]] && printf '%s' "$1" || printf '%s/%s' "$PWD" "$1"; }

# oneline <text>: the text with its line breaks as spaces.
oneline() { printf '%s' "$1" | tr '\r\n' '  '; }

questions='{"questions":[
  {"question":"Which fruit?","header":"Fruit","multiSelect":false,
   "options":[{"label":"apple","description":"A red fruit"},{"label":"cherry","description":"A small fruit"}]},
  {"question":"Which colors?","header":"Colors","multiSelect":true,
   "options":[{"label":"red"},{"label":"blue"},{"label":"green"}]}]}'

turn() {
  local p=$1 step=turn reply cmd='' marker='' before='' n job held free=''
  case $p in
  "lag held") until [ -e "$SB_HOME/report" ]; do sleep 0.05; done ;;
  lag*) sleep 1 ;;
  esac
  if [ -e "$SB_HOME/hold" ]; then until [ -e "$SB_HOME/report" ]; do sleep 0.05; done; fi
  if [ -z "$listed" ] && [ -f "$SB_HOME/skill-listing.jsonl" ]; then
    mkdir -p "$project"
    awk 1 "$SB_HOME/skill-listing.jsonl" >>"$project/$session.jsonl"
  fi
  listed=1
  case $p in
  /compact*)
    hook SessionStart '{"source":"compact"}'
    echo "⏺ compacted"
    return
    ;;
  /* | skill\ * | subskill\ *)
    gated "$p"
    return
    ;;
  esac
  transcript "$p"
  status
  case $p in
  *"Switchboard plan artifact task."*) reply=$(artifact "$p") ;;
  slow*)
    n=${p#slow }
    status busy
    step=tool reply="Slept $n s." cmd="sleep $n" marker='"hook_event_name":"PostToolUse"' before="sleep $n & slow_pid=\$!; wait \$slow_pid; slow_pid="
    [ "$n" = held ] && before="until [ -e '$SB_HOME/report' ]; do sleep 0.05; done & slow_pid=\$!; wait \$slow_pid; slow_pid="
    ;;
  run\ *)
    n=${p#run }
    if [ -f "$SB_HOME/$n.sh" ]; then
      step=tool reply="Ran $n." cmd="sh $SB_HOME/$n.sh" marker='"hook_event_name":"PostToolUse"' before="sh '$SB_HOME/$n.sh' </dev/null"
    else
      reply="Done: $p"
    fi
    ;;
  background*)
    read -r n held two <<<"${p#background }"
    [ "$held" = two ] && two=two held=''
    [ "$held" = free ] && free=1 held=''
    rm -f "$SB_HOME/job.pid" "$SB_HOME/job2.pid"
    # Claude Code runs each background job in a process group of its own,
    # and its spawn returns after the job is in that group. perl writes the
    # job's pid once the job is there, and the turn waits for that.
    perl -e 'setpgrp(0, 0); open(my $f, ">", shift) or die; print $f $$; close $f; exec @ARGV' \
      "$SB_HOME/job.pid" sleep "$n" &
    job=$!
    while kill -0 $job 2>/dev/null && [ ! -s "$SB_HOME/job.pid" ]; do sleep 0.01; done
    job2=$job
    if [ "$two" = two ]; then
      perl -e 'setpgrp(0, 0); open(my $f, ">", shift) or die; print $f $$; close $f; exec @ARGV' \
        "$SB_HOME/job2.pid" sleep "$n" &
      job2=$!
      while kill -0 $job2 2>/dev/null && [ ! -s "$SB_HOME/job2.pid" ]; do sleep 0.01; done
    fi
    step=background-job reply="Started a job of $n s." cmd="sleep $n" marker='<task-notification>'
    before="while kill -0 $job 2>/dev/null || kill -0 $job2 2>/dev/null; do sleep 0.05; done; sleep 0.5"
    [ "$held" = held ] && before="$before; until [ -e '$SB_HOME/report' ]; do sleep 0.05; done"
    ;;
  interrupt*)
    play interrupt "$(vars "$p" "" "sleep 100")"
    status idle
    echo "⏺ Interrupted"
    return
    ;;
  fail*)
    event turn UserPromptSubmit | emit "$(vars "$p" "")"
    if [ "${p#fail }" = authentication_failed ]; then
      hook StopFailure '{"error":"authentication_failed","last_assistant_message":"Login reached its time limit · Please run /login"}'
    else
      hook StopFailure '{"error":"rate_limit"}'
    fi
    echo "⏺ API Error"
    return
    ;;
  clear*)
    play clear "$(jq -nc --arg n "${p#clear }" '{session_id_2: $n}')"
    session=${p#clear }
    transcript /clear
    echo "⏺ cleared, now $session"
    return
    ;;
  context\ *)
    usage_line "${p#context }"
    reply="Context: ${p#context }"
    ;;
  mcp\ *)
    url=$(jq -r --arg n "${p#mcp }" '.mcpServers[$n].url' "$mcp_config")
    reply="MCP ${p#mcp }: $(curl -s --max-time 2 "$url" || echo "no answer from $url")"
    ;;
  onterm*)
    onterm=${p#onterm }
    reply="I'll write $onterm when I stop."
    ;;
  linger*)
    linger=${p#linger }
    reply="I'll linger $linger s when I stop."
    ;;
  perm*)
    asks "$p" Bash "$(jq -nc --arg c "${p#perm }" '{command: $c}')"
    return
    ;;
  edit\ *)
    local args
    read -r -a args <<<"${p#edit }"
    asks "$p" Edit "$(jq -nc --arg f "$(absolute "${args[0]}")" --arg o "${args[1]}" --arg n "${args[2]}" \
      '{file_path: $f, old_string: $o, new_string: $n}')"
    return
    ;;
  fetch\ *)
    asks "$p" WebFetch "$(jq -nc --arg u "${p#fetch }" '{url: $u, prompt: "Summarize the page"}')"
    return
    ;;
  "pick colors" | "pick fruit")
    local one
    one=$(jq -c --argjson i "$([ "$p" = "pick colors" ] && echo 1 || echo 0)" '{questions: [.questions[$i]]}' <<<"$questions")
    # A pick in the terminal answers with the question's first option.
    asks "$p" AskUserQuestion "$one" "$(jq -c '. + {answers: {(.questions[0].question): .questions[0].options[0].label}}' <<<"$one")"
    return
    ;;
  pick*)
    asks "$p" AskUserQuestion "$questions" \
      "$(jq -c '. + {answers: {"Which fruit?": "apple", "Which colors?": "red"}}' <<<"$questions")"
    return
    ;;
  card\ *)
    reply="I wrote the card ${p#card }."
    marker='"hook_event_name":"Stop"'
    before="$sb_cmd summary set <'$SB_HOME/${p#card }.json' >>'$SB_HOME/summary-set.log' 2>&1"
    ;;
  reply\ *) reply=$(cat "$SB_HOME/${p#reply }.md") ;;
  ask*) reply="Which database should I use, Postgres or SQLite?" ;;
  offer*) reply="I wrote the parser. Want me to run the tests?" ;;
  mode\ *)
    printf '%s' "${p#mode }" >"$mode_file"
    reply="Mode: ${p#mode }"
    ;;
  *) reply="Done: $p" ;;
  esac
  echo "⏺ $reply"
  reply_line "$reply"
  # The subshell shares the stub's process group, so sbd doesn't count it as a job.
  if [ -n "$free" ]; then
    play "$step" "$(vars "$p" "$reply" "$cmd")" "$marker" "$before" &
  else
    play "$step" "$(vars "$p" "$reply" "$cmd")" "$marker" "$before"
  fi
  status
}

ls "$config_dir"/projects/*/"$session.jsonl" >/dev/null 2>&1 && found=yes || found=no
case $source:$found in
startup:yes) echo "Error: Session ID $session is already in use." && exit 1 ;;
resume:no) echo "No conversation found with session ID: $session" && exit 1 ;;
esac
# Before the trap, so that SIGTERM at the dialog ends the stub with no hook,
# as it ends claude before its SessionStart.
if [ -e "$SB_HOME/start-linger" ]; then
  start_linger=$(<"$SB_HOME/start-linger")
  trap 'trap "" TERM; sleep "$start_linger"; exit 143' TERM
fi
while [ -e "$SB_HOME/hold-start" ]; do sleep 0.1; done
if [ -e "$SB_HOME/ask-trust" ] &&
  ! jq -e --arg k "$(pwd -P)" '.projects[$k].hasTrustDialogAccepted == true' "$config_dir/.claude.json" >/dev/null 2>&1; then
  trust_dialog
fi
# bash runs the trap only after a foreground command ends. The slow tool call
# sleeps in the background and waits for the sleep. So SIGTERM ends it at
# once, as SIGTERM ends a tool call of claude.
trap 'trap "" TERM; [ -n "${slow_pid-}" ] && kill "$slow_pid" 2>/dev/null; [ -n "$onterm" ] && echo stopped >"$onterm"; play sigterm; sleep "$linger"; exit 143' TERM
# The dialog's reader runs in the background, where stdin would be /dev/null.
exec 3<&0
printf '\033[?2004h'
play "$source"
echo "claude-stub $session ($source)"
[ -n "$prompt" ] && turn "$prompt"
# box: draws Claude Code's prompt box between two rules and moves the cursor
# after its ❯ and no-break space, so the tty echoes typed text into the box.
# sbd pastes only while the box shows empty. The box holds a dim placeholder,
# as Claude Code's does, so it reads as empty only in a capture with colors.
# Each line that read returns moves the cursor down one line, so unbox moves
# up one more than the lines read since box drew it, and clears the box
# before the turn prints.
box() { printf '%s\n❯\xc2\xa0\033[2mTry "fix lint errors"\033[0m\n%s\033[1A\033[3G' "$rule" "$rule"; boxed=0; }
unbox() { printf '\033[%dA\r\033[J' $((boxed + 1)); }
box
# tmux turns each LF of a paste into CR. The tty in cooked mode turns CR back
# into LF. A pasted message therefore reaches read as several lines. A line
# that ends inside a paste adds a new line to the prompt instead of
# submitting it. Two pastes before an Enter, as a message with images
# sends, put the first paste's end and the second paste on one line.
start=$'\e[200~' end=$'\e[201~' typed='' pasting=''
while IFS= read -r line; do
  boxed=$((boxed + 1))
  printf '%s\n' "$line" >>"$SB_HOME/stub-input.log"
  last=${line##*"$start"}
  if [[ $line == *"$start"* && $last != *"$end"* ]]; then pasting=1; elif [[ $line == *"$end"* ]]; then pasting=''; fi
  line=${line//"$start"/} line=${line//"$end"/}
  if [ -n "$pasting" ]; then
    typed+=$line$'\n'
    continue
  fi
  typed+=$line
  unbox
  [ -n "$typed" ] && turn "$typed"
  typed=''
  box
done
