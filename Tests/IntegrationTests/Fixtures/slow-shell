#!/bin/sh
# A pane shell that starts only when the test creates $SB_HOME/shell-go, as a
# login shell with a user's setup can take a while to start. The test decides
# when the shell is slow enough, so a loaded runner can't outrun it. It then
# runs /bin/sh with the same arguments.
until [ -e "$SB_HOME/shell-go" ]; do sleep 0.05; done
exec /bin/sh "$@"
