#!/usr/bin/env bash
# Runs the app's TerminalSelfTest against a private sbd, and checks the bytes
# that a stand-in for claude (Tests/GUI/received-bytes-stub) received from the
# app's terminal, as `sb screen` shows them. It opens the app's window, so it
# needs a logged-in macOS session with a display. bin/test never runs it. CI
# runs every check but drops in its gui-test job.
# It then quits the app, and separately kills it, and starts it again each
# time. It checks through sb and tmux that the session and both its panes are
# the same processes with the same screens.
# Next it types into a session's message field through the app's DraftSelfTest,
# selects another session and comes back, presses Esc, quits, and checks the
# draft after a relaunch and after two Escs.
# Then it closes the shell pane of the Manager, a work session, an Inbox item, and a chat
# through the app's ShellSelfTest: the pane's close button, `exit`, Ctrl-D, and
# the Session menu. It checks that the shell stays closed after a relaunch and
# a switch to another session, that Open Shell starts it again, that the pane
# attaches to a shell that `sb shell --open` starts right after `exit`, and that the
# Claude terminal keeps its tmux client and claude its process throughout.
# It also presses mouse buttons 4 and 5 and checks that they go back and forward
# between two selected sessions.
# Last it drops sets of files on the message field of a session, the Inbox, and
# a group chat through the app's DropSelfTest, and checks the chips, the
# errors, and the images that sbd received from the field's send.
# The keys check types into every field whose text goes to Claude through the
# app's KeySelfTest: the message field of a session, the Inbox, a group chat,
# and the Manager, a reply option, a decision's own answer, a permission
# card's message, a question card's answer, and the new-session prompt. In each
# it checks that Return sees an input method's marked text, then presses
# Shift+Return and Return, and checks that Claude got one message with the new
# line in it.
# Arguments name the checks to run (terminal, relaunch, drafts, shell, drops, keys). With
# none, it runs them all. SB_GUI_SKIP names checks to leave out, separated by spaces.
# The script ends the app, sbd, the tmux server, the stand-in, and its folder
# in /tmp when it exits, whether or not the checks passed. It keeps the app's
# log, the screen, and the pane PNGs in .build/gui-test/terminal. After any
# failure it also keeps sbd's log in .build/gui-test/sbd.log.
# Each launch sets SB_TERMINAL_TEST, SB_QUIT_FILE, SB_DRAFT_TEST, SB_SHELL_TEST,
# SB_DROP_TEST, or SB_KEY_TEST, so the app runs hidden and never takes focus. SB_TEST_VISIBLE=1
# shows the app as a normal launch does.
set -euo pipefail
cd "$(dirname "$0")/.."
root=$PWD
checks=("$@")
read -r -a skips <<<"${SB_GUI_SKIP:-}"
for name in ${checks[@]+"${checks[@]}"} ${skips[@]+"${skips[@]}"}; do
  case $name in
  terminal | relaunch | drafts | shell | drops | keys) ;;
  *)
    echo "bin/test-gui has no check named $name. The checks are terminal, relaunch, drafts, shell, drops, and keys." >&2
    exit 2
    ;;
  esac
done
wants() {
  [[ " ${SB_GUI_SKIP:-} " != *" $1 "* ]] && { [ ${#checks[@]} -eq 0 ] || [[ " ${checks[*]} " == *" $1 "* ]]; }
}

if [ "$(launchctl managername 2>/dev/null)" != Aqua ] && [ -z "${SB_GUI_ANY_SESSION:-}" ]; then
  echo "bin/test-gui needs a logged-in macOS session with a display. This is a $(launchctl managername) session." >&2
  echo "Set SB_GUI_ANY_SESSION=1 to try anyway." >&2
  exit 2
fi

source bin/lib/swift-testing.sh
echo "Building…"
build_output=$(swift build ${args[@]+"${args[@]}"} 2>&1) || { echo "$build_output" >&2; exit 1; }
bin_dir=$(swift build --show-bin-path)

# The folder is under /tmp, because a Unix socket path can't exceed 103 bytes.
# Tests/IntegrationTests/Fixtures/reap ends every process whose arguments
# name a /tmp/sbt.XXXXXX home, which are sbd, the tmux server and its clients,
# and the stand-in, and then removes the home.
home=$(mktemp -d /tmp/sbt.XXXXXX)
echo $$ >"$home/owner.pid"
app_pid=''
check=''
cleanup() {
  status=$?
  trap - EXIT
  # Any failure keeps the logs, including one that set -e or a signal caused.
  if [ "$status" -ne 0 ]; then
    mkdir -p .build/gui-test
    cp "$home/sbd.log" .build/gui-test/sbd.log 2>/dev/null || true
    save_shots 2>/dev/null || true
  fi
  if [ -n "$app_pid" ]; then kill -KILL "$app_pid" 2>/dev/null || true; fi
  SB_HOME="$home" Tests/IntegrationTests/Fixtures/reap || true
  exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT TERM HUP

export SB_HOME="$home"
sb() { "$bin_dir/sb" "$@"; }

jq -n --arg claude "$root/Tests/GUI/received-bytes-stub" --arg home "$home" \
  '{claude: $claude, idleStopSeconds: 600, tickSeconds: 0.2, worktreeRoot: "\($home)/worktrees",
    shell: "/bin/sh", github: {pollSeconds: 0}, triage: {systemPrompt: ""}}' >"$home/config.json"
mkdir "$home/work" "$home/shots"
: >"$home/sbd.log"
"$bin_dir/sbd" --home "$home" >>"$home/sbd.log" 2>&1 &

wait_for() { # <seconds> <command…>
  local deadline=$((SECONDS + $1))
  shift
  until "$@"; do
    if [ $SECONDS -ge $deadline ]; then return 1; fi
    sleep 0.2
  done
}

app_gone() { ! kill -0 "$app_pid" 2>/dev/null; }

end_app() {
  kill -KILL "$app_pid" 2>/dev/null || true
  wait "$app_pid" 2>/dev/null || true
  app_pid=''
}

# Replaces the last run's files in .build/gui-test/<check> with this run's.
save_shots() {
  [ -n "${check:-}" ] && [ -d "$home/shots/$check" ] || return 0
  [ -z "${session:-}" ] || sb screen "$session" >"$home/shots/$check/screen.txt" 2>/dev/null || true
  rm -rf ".build/gui-test/$check"
  mkdir -p ".build/gui-test/$check"
  cp -R "$home/shots/$check/." ".build/gui-test/$check/"
}

fail() {
  # The app runs the self tests on its main thread, so a sample shows where a stuck app waits.
  if [ -n "${app_pid:-}" ] && [ -d "$home/shots/${check:-}" ] && kill -0 "$app_pid" 2>/dev/null; then
    sample "$app_pid" 1 -file "$home/shots/$check/app-sample.txt" >/dev/null 2>&1 || true
  fi
  save_shots || true
  echo "FAIL ($check): $*" >&2
  echo "--- sbd log" >&2
  tail -n 20 "$home/sbd.log" >&2 || true
  local log
  for log in "$home/shots/$check/app.log" "$home/shots/$check/session.log" "$home/shots/$check/inbox.log" "$home/shots/$check/chat.log"; do
    [ -f "$log" ] || continue
    echo "--- ${log##*/}" >&2
    tail -n 20 "$log" >&2 || true
  done
  echo "--- screen" >&2
  cat "$home/shots/$check/screen.txt" >&2 || true
  exit 1
}

wait_for 30 sb ls >/dev/null 2>&1 || check=sbd fail "sbd did not answer"
screen_has_stub() { sb screen "$session" 2>/dev/null | grep -q '^sizes '; }
# Sets $session to a new session, once its stand-in claude has drawn its screen.
new_session() {
  session=$(sb new "$home/work" --name "$1" --json | jq -r '.id')
  [ -n "$session" ] && [ "$session" != null ] || check=sbd fail "sb new returned no session id"
  wait_for 30 screen_has_stub || check=stub fail "the stand-in claude never drew its screen"
}

# What the stand-in receives, in order: a b c, Return, Ctrl-C, Option-b, Up,
# Down, Left, Backspace, Escape, Tab, Shift-Tab, x, a dead key followed by e
# (é), and a bracketed paste of two lines. Marked text and modifier keys on
# their own send nothing. Shift-Tab is ESC [ Z. A pasted newline is a line feed.
expected="61 62 63 0d 03 1b 62 1b 5b 41 1b 5b 42 1b 5b 44 7f 1b 09 1b 5b 5a 78 c3 a9 1b 5b 32 30 30 7e"
expected+=" 70 61 73 74 65 20 6c 69 6e 65 20 6f 6e 65 0a 70 61 73 74 65 20 6c 69 6e 65 20 74 77 6f 0a 1b 5b 32 30 31 7e"

check_terminal() {
  check=terminal
  local shots="$home/shots/$check"
  mkdir "$shots"
  echo "Checking the terminal…"

  SB_SELECT="$session" SB_TERMINAL_TEST="$shots" SB_TERMINAL_TEST_EXIT=1 \
    SB_TERMINAL_TEST_READY="$shots/ready" \
    "$bin_dir/Switchboard" >"$shots/app.log" 2>&1 &
  app_pid=$!
  app_alive() { kill -0 "$app_pid" 2>/dev/null; }
  # Records how the app ended in its log, and ends the run when it is not alive.
  check_app_alive() {
    app_alive && return 0
    local status=0
    wait "$app_pid" || status=$?
    app_pid=''
    echo "app exited with status $status" >>"$shots/app.log"
    fail "the app exited with status $status $1"
  }
  # The stand-in starts at 200x50 and sees a new size once the app's terminal attaches and resizes it.
  pane_resized() { sb screen "$session" 2>/dev/null | grep -q '^sizes [^ ]* [^ ]' || ! app_alive; }
  wait_for 120 pane_resized || fail "the stand-in never saw the app's terminal attach"
  check_app_alive "before its terminal attached"
  touch "$shots/ready"
  finished() { grep -q '^selftest: \(done\|no terminal pane\)' "$shots/app.log" || ! app_alive; }
  wait_for 240 finished || fail "the self test did not finish"
  if ! grep -q '^selftest: done' "$shots/app.log"; then check_app_alive "during the self test"; fi
  end_app

  save_shots

  grep -q '^selftest: done' "$shots/app.log" || fail "the self test did not reach the end"
  grep -q '^selftest: attached after' "$shots/app.log" || fail "the app never saw the session attach: $(grep '^selftest: gave up' "$shots/app.log")"
  if [ "${SB_TEST_VISIBLE:-}" != 1 ]; then
    grep -qx 'selftest: launch accessory active=false alpha=0.0' "$shots/app.log" ||
      fail "the app did not stay hidden and inactive: $(grep '^selftest: launch' "$shots/app.log")"
  fi

  local got
  got=$(sed -n 's/^rx //p' "$shots/screen.txt" | tr '\n' ' ' | tr -s ' ' | sed 's/ $//')
  if [ "$got" != "$expected" ]; then
    echo "expected: $expected" >&2
    echo "received: $got" >&2
    fail "the stand-in received other bytes"
  fi

  # tmux and the app size the pane before the window shrinks, so the list
  # starts with sizes from before the app attached. The window then got 300 pt
  # narrower and 200 pt shorter and went back: the last size appeared before,
  # with a different size in between.
  read -r -a sizes <<<"$(sed -n 's/^sizes //p' "$shots/screen.txt")"
  local last=${sizes[${#sizes[@]} - 1]} seen='' changed='' size
  for size in "${sizes[@]:0:${#sizes[@]}-1}"; do
    if [ "$size" = "$last" ]; then seen=1; elif [ -n "$seen" ]; then changed=1; fi
  done
  [ -n "$changed" ] || fail "the pane did not shrink and return to $last: ${sizes[*]}"
  # The app logs the width of the padded pane and of one cell. The stand-in's last column count must be
  # the number of whole cells in the padded pane less 10 pt on each side.
  local padded
  padded=$(sed -n 's/^selftest: padded pane \([0-9.]*\) cell \([0-9.]*\)$/\1 \2/p' "$shots/app.log")
  [ -n "$padded" ] || fail "the app did not log the padded pane's size"
  awk -v cols="${last%x*}" -v sizes="$padded" 'BEGIN {
    split(sizes, s, " "); exit cols != int((s[1] - 20) / s[2])
  }' || fail "$last does not fill the padded pane (width and cell: $padded)"
  for png in pane-start pane-resized pane-end pane-padded; do
    [ -s "$shots/$png.png" ] || fail "missing $png.png"
  done
  echo "ok: $check (sizes ${sizes[*]})"
}

if wants terminal; then
  new_session selftest
  check_terminal
fi

# The stand-in's screen keeps every byte it received, so a restarted stand-in
# would lose them. The shell's pid shows whether its process is the same one.
check_relaunch() {
  check=relaunch
  local shots="$home/shots/relaunch" tmux_socket="$home/tmux.sock" before how
  mkdir "$shots"
  new_session relaunch
  local shell_target="=$session-shell:" claude_target="=$session-claude:"
  attached() { sb ls --json | jq -e --arg id "$session" '.[] | select(.id == $id) | .attached' >/dev/null; }
  no_clients() { ! attached && ! shell_clients; }
  shell_clients() { [ -n "$(tmux -S "$tmux_socket" list-clients -t "=$session-shell" 2>/dev/null)" ]; }
  start_app() {
    rm -f "$shots/quit"
    SB_SELECT="$session" SB_QUIT_FILE="$shots/quit" "$bin_dir/Switchboard" >>"$shots/app.log" 2>&1 &
    app_pid=$!
    wait_for 120 attached || fail "the app did not attach to the Claude pane"
    wait_for 60 shell_clients || fail "the app did not attach to the shell pane"
  }
  shell_has() { sb screen "$session" --shell | grep -q "$1"; }
  shell_pid() {
    local mark=$1
    tmux -S "$tmux_socket" send-keys -t "$shell_target" "echo $mark-\$\$" Enter
    wait_for 20 shell_has "$mark-[0-9]" || fail "the shell did not answer $mark"
    sb screen "$session" --shell | grep -o "$mark-[0-9]*" | tail -n 1 | sed 's/.*-//'
  }
  fingerprint() { # every session's record, every tmux pane's pid, and this session's stand-in screen
    {
      sb ls --json | jq -c '[.[] | {id, name, state, claudePid}] | sort_by(.id)'
      tmux -S "$tmux_socket" list-panes -a -F '#{session_name} #{pane_pid} #{pane_dead}' | sort
      sb screen "$session" | sed -n '/^rx /p'
    }
  }

  # The stand-in redraws its screen when the app resizes it, so a read can catch a partial redraw.
  matches_before() { [ "$(fingerprint)" = "$before" ]; }
  unchanged() {
    wait_for 5 matches_before || {
      local after
      after=$(fingerprint) diff <(echo "$before") <(echo "$after") >&2 || true
      fail "the session changed $1"
    }
  }
  sb_rx_has() { sb screen "$session" | grep -q "^rx.* $1"; }

  echo "Checking that sessions survive the app (relaunch)…"
  start_app
  tmux -S "$tmux_socket" send-keys -t "$claude_target" abc
  wait_for 20 sb_rx_has "61 62 63" || fail "the stand-in did not receive the typed bytes"
  local shell_before shell_after
  shell_before=$(shell_pid before)
  before=$(fingerprint)

  for how in quit kill; do
    if [ "$how" = quit ]; then
      touch "$shots/quit"
      wait_for 30 app_gone || fail "the app did not quit"
      local status=0
      wait "$app_pid" || status=$?
      app_pid=''
      [ "$status" -eq 0 ] || fail "the app exited with status $status when it quit"
    else
      end_app
    fi
    sb ls --json | jq -e --arg id "$session" 'any(.[]; .id == $id)' >/dev/null || fail "the session is gone after the app ended ($how)"
    wait_for 10 no_clients || fail "the app's terminals stayed attached after $how"
    unchanged "while the app was gone ($how)"
    start_app
    unchanged "after the app came back ($how)"
    shell_after=$(shell_pid "again-$how")
    [ "$shell_after" = "$shell_before" ] || fail "the shell is a new process after $how"
  done
  end_app
  echo "ok: relaunch (quit and kill)"
}

if wants relaunch; then check_relaunch; fi

# The draft lives in the app, not in sbd, so the app's own log is the evidence.
check_drafts() {
  check=drafts
  local shots="$home/shots/drafts" other typed="draft survives a switch"
  mkdir "$shots"
  echo "Checking message drafts…"
  new_session drafts-other
  other=$session
  new_session drafts
  run_step() { # <step>
    SB_SELECT="$session" SB_DRAFT_TEST="$1" SB_DRAFT_TEST_OTHER="$other" \
      "$bin_dir/Switchboard" >>"$shots/app.log" 2>&1 &
    app_pid=$!
    wait_for 120 app_gone || fail "the app did not finish the $1 step"
    end_app
  }
  logged() { grep -qxF "drafttest: $1" "$shots/app.log" || fail "the app did not log: $1"; }

  run_step type
  logged "typed: $typed"
  logged "other session: "
  logged "after switch: $typed"
  logged "after one esc: $typed hint true"
  logged "hint after the window: false"
  jq -e --arg id "$session" --arg text "$typed" '.[$id].text == $text' "$home/drafts/drafts.json" >/dev/null ||
    fail "drafts.json does not hold the draft"

  run_step check
  logged "after relaunch: $typed"
  logged "after two escs: "
  wait_for 5 jq -e 'length == 0' "$home/drafts/drafts.json" >/dev/null || fail "drafts.json still holds a draft after two Escs"
  save_shots
  echo "ok: drafts (switch, Esc, relaunch)"
}

if wants drafts; then check_drafts; fi

# sbd records whether the shell is closed, so sb and tmux are the evidence. The
# app's log shows each step, and its PNGs show the window after the close.
check_shell() {
  check=shell
  local shots="$home/shots/shell" tmux_socket="$home/tmux.sock" manager work chat group cc cp
  mkdir "$shots"
  echo "Checking the shell pane…"
  manager=$(sb manager --json | jq -r .id)
  new_session shell-work
  work=$session
  sb group add shell-group "$work" >/dev/null
  group=$(sb groups --json | jq -r '.groups[] | select(.name == "shell-group") | .id')
  chat=$(sb chat "$group" --json | jq -r .id)
  clients() { tmux -S "$tmux_socket" list-clients -t "=$1" -F '#{client_pid}' 2>/dev/null | sort | tr '\n' ' '; }
  has_clients() { [ -n "$(clients "$1")" ]; }
  shell_gone() { ! tmux -S "$tmux_socket" has-session -t "=$1-shell" 2>/dev/null; }
  closed() { sb get "$1" --json | jq -e '.shellClosed == true' >/dev/null; }
  is_open() { ! closed "$1"; }
  cmd_done() { [ ! -e "$shots/cmd" ]; }
  app() { # runs one ShellSelfTest command and prints its result
    # The app polls for cmd. The rename makes the whole command appear at once.
    echo "$*" >"$shots/cmd.tmp"
    mv "$shots/cmd.tmp" "$shots/cmd"
    wait_for 20 cmd_done || fail "the app did not run: $*"
    grep "^shelltest: " "$shots/app.log" | tail -n 1 | sed 's/.*-> //'
  }
  panes_are() { [ "$(app panes)" = "$1" ]; }
  click() { # <close | open> <where>
    local result
    result=$(app click "$1")
    [[ $result == "clicked at "* ]] || fail "the app could not click $1 on $2: $result"
  }
  # A chat shows its messages until the test shows its terminals, so `attached` waits only when asked.
  start_app() { # <session> [attached]
    SB_SELECT="$1" SB_SHELL_TEST="$shots" "$bin_dir/Switchboard" >>"$shots/app.log" 2>&1 &
    app_pid=$!
    [ -z "${2:-}" ] || wait_for 120 has_clients "$1-claude" || fail "the app did not attach to $1's Claude pane"
  }
  remember_claude() { cc=$(clients "$1-claude") cp=$(sb get "$1" --json | jq -r .claudePid); }
  same_claude() {
    [ "$(clients "$1-claude")" = "$cc" ] || fail "the Claude terminal of $1 attached again"
    [ "$(sb get "$1" --json | jq -r .claudePid)" = "$cp" ] || fail "claude of $1 is a new process"
  }
  closes() { # <session> <how>
    wait_for 10 closed "$1" || fail "$2 did not close the shell of $1"
    wait_for 10 shell_gone "$1" || fail "$2 left the shell of $1 in tmux"
    wait_for 10 panes_are 1 || fail "$2 left the shell pane of $1 in the window"
    same_claude "$1"
  }

  start_app "$manager" attached
  wait_for 60 has_clients "$manager-shell" || fail "the app did not attach to the Manager's shell"
  remember_claude "$manager"
  click close "the Manager"
  closes "$manager" "the close button"
  app snapshot "$shots/manager-closed.png" >/dev/null
  end_app
  start_app "$manager" attached
  sleep 2
  shell_gone "$manager" && panes_are 1 || fail "a relaunch started the Manager's shell again"
  remember_claude "$manager"
  click open "the Manager"
  wait_for 10 is_open "$manager" || fail "Open Shell did not open the Manager's shell"
  wait_for 60 has_clients "$manager-shell" || fail "the app did not attach to the opened shell"
  app type exit >/dev/null
  closes "$manager" "exit"
  end_app

  start_app "$work" attached
  wait_for 60 has_clients "$work-shell" || fail "the app did not attach to the work session's shell"
  remember_claude "$work"
  app ctrl-d >/dev/null
  closes "$work" "Ctrl-D"
  app select "$manager" >/dev/null
  sleep 3
  app select "$work" >/dev/null
  sleep 3
  shell_gone "$work" && shell_gone "$manager" || fail "switching sessions started a closed shell again"
  [ "$(app menu Session Open Shell)" = ran ] || fail "the Session menu has no Open Shell"
  wait_for 60 has_clients "$work-shell" || fail "the menu's Open Shell did not open the shell"
  remember_claude "$work"
  # A shell that closes and opens again before the app's next refresh leaves the pane on screen.
  exited() { shell_gone "$work" || tmux -S "$tmux_socket" display -p -t "=$work-shell:" '#{pane_dead}' | grep -q 1; }
  app type exit >/dev/null
  wait_for 10 exited || fail "exit did not end the work session's shell"
  sb shell "$work" --open >/dev/null
  wait_for 30 has_clients "$work-shell" || fail "the shell pane did not attach to the reopened shell"
  wait_for 10 panes_are 2 || fail "the reopened shell has no pane"
  same_claude "$work"
  [ "$(app menu Session Close Shell)" = ran ] || fail "the Session menu has no Close Shell"
  closes "$work" "the menu's Close Shell"
  end_app

  # The Inbox shows an item's terminals without selecting the session.
  SB_INBOX="$work" SB_SHELL_TEST="$shots" "$bin_dir/Switchboard" >>"$shots/app.log" 2>&1 &
  app_pid=$!
  app show-terminal >/dev/null
  wait_for 120 has_clients "$work-claude" || fail "the Inbox did not attach to the work session's Claude pane"
  remember_claude "$work"
  click open "the Inbox"
  wait_for 10 is_open "$work" || fail "the Inbox's Open Shell did not open the shell"
  wait_for 60 has_clients "$work-shell" || fail "the Inbox did not attach to the opened shell"
  wait_for 10 panes_are 2 || fail "the Inbox shows no shell pane"
  click close "the Inbox"
  closes "$work" "the Inbox's close button"
  end_app

  start_app "$chat"
  app show-terminal >/dev/null
  wait_for 120 has_clients "$chat-claude" || fail "the app did not attach to the chat's Claude pane"
  wait_for 60 has_clients "$chat-shell" || fail "the app did not attach to the chat's shell"
  remember_claude "$chat"
  click close "the chat"
  closes "$chat" "the chat's close button"
  app snapshot "$shots/chat-closed.png" >/dev/null
  # Close acts on the key window. An app that a script starts may have none, so this checks only the binding.
  [ "$(app cmd-w)" = "handled true by Close" ] || fail "⌘W is not the window's Close"
  # A focused terminal keeps every key but the menu's, so these must reach their own menu items. Without a
  # key window, SwiftUI does not refresh the menu's enabled states. Move Focus to Terminal then keeps its
  # state from launch, disabled, and the result names the item that owns ⌘T instead. ⌘K goes last, because
  # it opens the search sheet.
  # Back, Forward, and Show Recent Places keep their launch state in the same way.
  nav=$(app nav-keys)
  expected="} ran Next Session; { ran Previous Session; l ran Move Focus to List"
  rest="$nav"
  [[ $rest == "$expected; "* ]] || fail "the navigation shortcuts did not run their menu items: $nav"
  rest=${rest#"$expected; "}
  for part in "t:Move Focus to Terminal" "[:Back" "]:Forward" "y:Show Recent Places"; do
    key=${part%%:*} item=${part#*:}
    ran="$key ran $item; " off="$key ran none ($item is disabled); "
    if [[ $rest == "$ran"* ]]; then
      rest=${rest#"$ran"}
    elif [[ $rest == "$off"* ]]; then
      rest=${rest#"$off"}
    else
      fail "the navigation shortcuts did not run $item: $nav"
    fi
  done
  [ "$rest" = "k ran Search Sessions…" ] || fail "the navigation shortcuts did not run their menu items: $nav"
  end_app

  # Mouse buttons 4 and 5 go back and forward through the sessions the user selected.
  start_app "$work"
  app select "$manager" >/dev/null
  shows() { [ "$(app where)" = "session(\"$1\")" ]; }
  wait_for 5 shows "$manager" || fail "selecting the Manager did not show it: $(app where)"
  [ "$(app mouse 3)" = posted ] || fail "the app could not post mouse button 4"
  wait_for 5 shows "$work" || fail "mouse button 4 did not go back to the work session: $(app where)"
  [ "$(app mouse 4)" = posted ] || fail "the app could not post mouse button 5"
  wait_for 5 shows "$manager" || fail "mouse button 5 did not go forward to the Manager: $(app where)"
  end_app
  save_shots
  echo "ok: shell (close button, exit, Ctrl-D, menu, relaunch, switch, reopen; Manager, work, Inbox, chat; mouse back and forward)"
}

if wants shell; then check_shell; fi

# The drops live in the app until the send, so the app's log is the evidence
# for each step, and sbd's copies are the evidence for the send.
check_drops() {
  check=drops
  local shots="$home/shots/drops" view chat files line copies sent path target paths
  mkdir "$shots"
  echo "Checking drops on the message field…"
  new_session drops-chat-member
  "$bin_dir/sb" group add drops "$session" >/dev/null
  chat=$("$bin_dir/sb" chat drops --json | jq -r '.id')
  [ -n "$chat" ] && [ "$chat" != null ] || fail "sb chat returned no session id"
  new_session drops
  local expected=(
    "two: targets DropView | chips a.png b.jpg | error  | text "
    "three: targets DropView | chips a.png b.jpg c.gif | error  | text "
    "five: targets DropView | chips e.png a.png d.png b.jpg c.gif | error  | text "
    "two drags: targets DropView DropView | chips a.png b.jpg c.gif | error  | text "
    "mixed: targets DropView | chips a.png b.jpg | error notes.txt isn't an image. | text "
    "folder: targets DropView | chips a.png | error shots isn't an image. | text "
    "over the count limit: targets DropView | chips $(printf 'n%02d.png ' $(seq 20))| error n21.png, n22.png aren't attached: a message can carry at most 20 images. | text "
    "focused one: targets DropView | chips a.png | error  | text "
    "focused two: targets DropView | chips a.png b.jpg | error  | text "
    "typed then three: targets DropView | chips a.png b.jpg c.gif | error  | text look at these"
    "file with its text: targets DropView | chips a.png | error  | text "
    "promise drag: targets DropView copy"
    "text drag: targets DropView | chips  | error  | text look at this"
    "link drag: targets DropView | chips  | error  | text see https://example.com/a.png"
    "focused two drags: targets DropView DropView | chips a.png b.jpg c.gif | error  | text "
    "a click focuses the field: true"
    "editor types after a click: "
    "editor types after typing: "
    "editor types after the draft changed: "
    "editor types after another window was key: "
    "editor types after focus left: "
    "paste of three handled true | chips Pasted image.png Pasted image.png Pasted image.png"
    "field moved with 20 chips: 0.0"
    "after removing b.jpg: chips a.png c.gif"
    "after send: chips  | text "
    "done"
  )
  for view in session inbox chat; do
    files="$shots/$view"
    mkdir "$files"
    case $view in
    session) target=(SB_SELECT="$session") ;;
    inbox) target=(SB_INBOX="$session") ;;
    chat) target=(SB_SELECT="$chat") ;;
    esac
    env "${target[@]}" SB_DROP_TEST="$files" "$bin_dir/Switchboard" >"$shots/$view.log" 2>&1 &
    app_pid=$!
    wait_for 180 app_gone || fail "the app did not finish the drops in the $view"
    end_app
    for line in "${expected[@]}"; do
      grep -qxF "droptest: $line" "$shots/$view.log" || fail "the $view field did not log: $line"
    done
    [ -s "$files/chips.png" ] || fail "the $view run drew no chips.png"
  done

  # The session view and the Inbox each sent a.png b.jpg c.gif to the session.
  copies=$(find "$home/sessions/$session/attachments" -type f | wc -l | tr -d ' ')
  [ "$copies" -eq 6 ] || fail "sbd kept $copies copies for the session, not 6"
  sent=$("$bin_dir/sb" events --session "$session" --json | jq -rs '[.[] | select(.kind == "sent")] | last | .data.text')
  [ "$(head -n 1 <<<"$sent")" = "look at these" ] || fail "the last send's text is not \"look at these\": $sent"
  read -r -a paths <<<"$(tail -n 1 <<<"$sent")"
  [ ${#paths[@]} -eq 3 ] || fail "the last send does not name 3 copies: $sent"
  for path in "${paths[@]}"; do [ -f "$path" ] || fail "the send names $path, which is not a copy"; done
  save_shots
  echo "ok: drops (session, Inbox, chat)"
}

if wants drops; then check_drops; fi

# Each field logs its text after each key, and sbd or the held hook shows what Claude got.
check_keys() {
  check=keys
  local shots="$home/shots/keys" inbox chat manager reply decide deny ask view got
  local typed='"onex\ntwo"'
  mkdir "$shots"
  echo "Checking Return and Shift+Return in the fields that send to Claude…"
  new_session keys-chat-member
  sb group add keys "$session" >/dev/null
  chat=$(sb chat keys --json | jq -r '.id')
  [ -n "$chat" ] && [ "$chat" != null ] || fail "sb chat returned no session id"
  manager=$(sb manager --json | jq -r '.id')
  [ -n "$manager" ] && [ "$manager" != null ] || fail "sb manager returned no session id"
  new_session keys-reply
  reply=$session
  SB_SESSION_ID="$reply" sb summary set >/dev/null <<'CARD' || fail "sb summary set refused the reply card"
{"summary": "It needs a call.", "options": [{"label": "Go on", "action": "send"},
 {"label": "Something else", "action": "reply", "placeholder": "What else?"}]}
CARD
  new_session keys-decide
  decide=$session
  SB_SESSION_ID="$decide" sb summary set >/dev/null <<'CARD' || fail "sb summary set refused the decisions"
{"title": "Two decisions", "summary": "It needs two decisions.", "decisions": [
 {"number": 1, "header": "Name", "question": "What name?", "options": [{"label": "to-do"}, {"label": "note"}]},
 {"number": 2, "header": "Ship", "question": "Ship it?", "options": [{"label": "Yes"}, {"label": "No"}]}]}
CARD
  # A hook that sbd holds until its card gets an answer, as claude's PermissionRequest hook does.
  held_hook() { # <session> <tool> <input> <out>
    jq -nc --arg t "$home/$1.jsonl" --arg tool "$2" --argjson input "$3" \
      '{hook_event_name: "PermissionRequest", session_id: "stub", transcript_path: $t,
        permission_mode: "default", tool_name: $tool, tool_input: $input, cwd: "/tmp"}' |
      SB_SESSION_ID="$1" "$bin_dir/sb" hook >"$4" 2>&1 &
  }
  new_session keys-deny
  deny=$session
  held_hook "$deny" Bash '{"command": "make clean"}' "$shots/deny.out"
  new_session keys-ask
  ask=$session
  held_hook "$ask" AskUserQuestion \
    '{"questions": [{"question": "Which fruit?", "header": "Fruit", "multiSelect": false,
      "options": [{"label": "apple", "description": "red"}, {"label": "pear", "description": "green"}]}]}' \
    "$shots/ask.out"
  has_card() { sb get --json "$1" | jq -e '.cards | length > 0' >/dev/null; }
  wait_for 20 has_card "$deny" || fail "the permission hook made no card"
  wait_for 20 has_card "$ask" || fail "the question hook made no card"
  new_session keys-inbox
  inbox=$session
  new_session keys
  key_logged() { grep -qxF "keytest: $2" "$shots/$1.log" || fail "the $1 field did not log: $2"; }

  for view in session inbox chat manager reply decision deny answer prompt; do
    local target=() field="Message Claude…"
    case $view in
    session) target=(SB_SELECT="$session") ;;
    inbox) target=(SB_INBOX="$inbox") ;;
    chat) target=(SB_SELECT="$chat") ;;
    manager) target=(SB_SELECT="$manager") ;;
    reply) target=(SB_INBOX="$reply") field="What else?" ;;
    decision) target=(SB_INBOX="$decide") field="Type your own answer" ;;
    deny) target=(SB_SELECT="$deny") field="Message for Claude (optional)" ;;
    answer) target=(SB_SELECT="$ask") field="Or type an answer" ;;
    prompt) target=(SB_SHEET=new) field=prompt ;;
    esac
    env "${target[@]}" SB_KEY_TEST="$field" "$bin_dir/Switchboard" >"$shots/$view.log" 2>&1 &
    app_pid=$!
    wait_for 120 app_gone || fail "the app did not finish the keys in the $view"
    end_app
    if [ "$view" = prompt ]; then
      key_logged "$view" 'shift-return: "one\ntwo\n"'
      key_logged "$view" "sheet open: true"
      key_logged "$view" 'return: "one\ntwo\n\n"'
    else
      key_logged "$view" "composing at return: true"
      key_logged "$view" 'shift-return: "onex\ntwo\n"'
    fi
    key_logged "$view" done
  done

  sent_texts() { sb events --session "$1" --json | jq -c -s '[.[] | select(.kind == "sent") | .data.text]'; }
  for view in session inbox chat manager reply; do
    got=$(sent_texts "${!view}")
    [ "$got" = "[$typed]" ] || fail "the $view sent $got, not [$typed]"
  done
  got=$(sb decide --json "$decide" | jq -c '[.answers[] | select(.number == 1) | .. | strings]')
  [[ "$got" == *"$typed"* ]] || fail "the decision's answer is $got"
  got=$(jq -c '[.. | .message? // empty]' "$shots/deny.out")
  [ "$got" = "[$typed]" ] || fail "the permission hook got the message $got: $(cat "$shots/deny.out")"
  got=$(jq -c '[.. | .answers? // empty | .["Which fruit?"]]' "$shots/ask.out")
  [ "$got" = "[$typed]" ] || fail "the question hook got the answer $got: $(cat "$shots/ask.out")"
  save_shots
  echo "ok: keys (session, Inbox, chat, Manager, reply, decision, deny, answer, prompt)"
}

if wants keys; then check_keys; fi
