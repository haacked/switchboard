#!/usr/bin/env bash
# Splits the tests into the swift test processes that bin/test --shards runs.
#
#   bin/lib/shard-plan <shards> <weights-file> < test-list
#
# The test list has one test per line, as `swift test list` prints them, such
# as IntegrationTests.FooTests/bar(). Prints one "<slot> <filter>" line for
# each process, where <filter> is an extended regular expression for
# swift test --filter. Slots 0 to <shards>-1 run integration suites. Slot
# <shards> runs the other test targets. Slot <shards>+1 runs MeasureTests.
#
# Each integration suite, slowest first, goes to the shard with the least time
# so far. The weights file gives each suite's seconds, one "<seconds> <suite>"
# line each. bin/shard-weights rebuilds it from a CI log. A suite the file
# doesn't list gets its test count times the mean seconds per test of the
# suites with a weight above 0. A suite with weight 0 holds no slot in CI.
# Without the file, that splits the suites by test count. The other targets
# take seconds and run in their own process. Their time limits then never wait
# behind integration tests that block threads. MeasureTests skips its timing
# check while the load average is above the CPU count, as it is while the
# shards run, so bin/test runs it last, once the load drops.
#
# Exits 1 when the list has no MeasureTests suite or when the filters do not
# match every test, and 2 on a bad argument.
set -euo pipefail
quiet=IntegrationTests.MeasureTests
[ $# -eq 2 ] || { echo "usage: bin/lib/shard-plan <shards> <weights-file> < test-list" >&2; exit 2; }
n=$1 weights=$2
[[ $n =~ ^[1-9][0-9]*$ ]] || { echo "shard-plan: the shard count must be a positive whole number, not '$n'" >&2; exit 2; }
list=$(cat)
total=$(grep -c . <<<"$list" || true)
plan=$(awk -F/ -v weights="$weights" '
  BEGIN { while ((getline line < weights) > 0) { split(line, f, " "); seconds[f[2]] = f[1] } }
  { count[$1]++ }
  END { for (key in count) if ((key in seconds) && seconds[key] > 0) { listed += seconds[key]; tests += count[key] }
    rate = tests ? listed / tests : 1
    for (key in count) {
      w = (key in seconds) ? seconds[key] : count[key] * rate
      print w, key } }' <<<"$list" |
  sort -k1,1rn -k2,2 | awk -v n="$n" -v quiet="$quiet" '
  { key = $2
    gsub(/\./, "\\.", key)
    s = n
    if ($2 == quiet) s = n + 1
    else if ($2 ~ /^IntegrationTests($|\.)/) {
      s = 0
      for (i = 1; i < n; i++) if (load[i] < load[s]) s = i
      load[s] += $1
    }
    keys[s] = (s in keys) ? keys[s] "|" key : key }
  END { for (s in keys) print s, "^(" keys[s] ")/" }' | sort -n)
if ! grep -q "^$((n + 1)) " <<<"$plan"; then
  echo "shard-plan: the tests have no $quiet suite to run alone" >&2
  exit 1
fi
matched=0
while read -r _ pattern; do
  matched=$((matched + $(grep -c -E "$pattern" <<<"$list" || true)))
done <<<"$plan"
if [ "$matched" -ne "$total" ]; then
  echo "shard-plan: the filters match $matched of $total tests" >&2
  exit 1
fi
printf '%s\n' "$plan"
