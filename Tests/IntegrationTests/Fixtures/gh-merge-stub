#!/bin/bash
# A stand-in for gh in sbd's merge tests. It records each call in
# $SB_HOME/gh-calls.log. `gh auth token` prints a token. `gh pr merge` and
# `gh pr comment` first read one line from $SB_HOME/gh-merge-gate when that
# file is a FIFO, so a test can keep the call running. They then print
# $SB_HOME/gh-merge-error to stderr and exit 1 when that file exists, and exit
# 0 otherwise.
printf '%s\n' "$*" >>"$SB_HOME/gh-calls.log"
case "$1 $2" in
"auth token")
  echo "token-1"
  ;;
"pr merge" | "pr comment")
  if [ -p "$SB_HOME/gh-merge-gate" ]; then read -r _ <"$SB_HOME/gh-merge-gate"; fi
  if [ -f "$SB_HOME/gh-merge-error" ]; then
    cat "$SB_HOME/gh-merge-error" >&2
    exit 1
  fi
  ;;
*)
  exit 1
  ;;
esac
