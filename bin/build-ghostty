#!/usr/bin/env bash
# Builds libghostty from the commit in ghostty.pin into .build/ghostty:
# GhosttyKit.xcframework (native arm64) and share/ (shell integration, terminfo).
# SB_GHOSTTY=1 swift build links the app against it. bin/test, bin/bundle, and
# bin/install never run this. It needs full Xcode (the Metal toolchain) and
# the zig version named in ghostty.pin, which mise provides.
set -euo pipefail
cd "$(dirname "$0")/.."
commit=$(sed -n 's/^commit=//p' ghostty.pin)
zig_version=$(sed -n 's/^zig=//p' ghostty.pin)
src=.build/ghostty-src
out=.build/ghostty

zig="$(mise where "zig@$zig_version" 2>/dev/null || true)/zig"
if [ ! -x "$zig" ]; then
  echo "zig $zig_version is missing. Run: mise install zig@$zig_version" >&2
  exit 1
fi
if ! xcrun -f metal >/dev/null 2>&1; then
  echo "The Metal toolchain is missing. Run: xcodebuild -downloadComponent MetalToolchain" >&2
  exit 1
fi

mkdir -p "$src"
[ -d "$src/.git" ] || git -C "$src" init -q
git -C "$src" remote get-url origin >/dev/null 2>&1 || git -C "$src" remote add origin https://github.com/ghostty-org/ghostty
if [ "$(git -C "$src" rev-parse HEAD 2>/dev/null || true)" != "$commit" ]; then
  git -C "$src" fetch -q --depth 1 origin "$commit"
  git -C "$src" checkout -q --force FETCH_HEAD
fi
git -C "$src" reset -q --hard "$commit"

# -Demit-xcframework alone also builds the whole Ghostty app with xcodebuild, which takes minutes.
(cd "$src" && "$zig" build -Doptimize=ReleaseFast -Demit-xcframework=true -Demit-macos-app=false \
  -Dxcframework-target=native -Dsentry=false --prefix "$PWD/../ghostty-out" \
  --cache-dir "$PWD/../ghostty-zig-cache" --global-cache-dir "$PWD/../ghostty-zig-global")

rm -rf "$out"
mkdir -p "$out"
cp -R "$src/macos/GhosttyKit.xcframework" "$out/"
cp -R .build/ghostty-out/share "$out/share"
echo "Built $out/GhosttyKit.xcframework. Link it with: SB_GHOSTTY=1 swift build, then run with SB_TERMINAL=ghostty."
