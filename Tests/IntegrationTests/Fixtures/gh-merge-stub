#!/bin/bash
# A stand-in for gh in sbd's merge and review tests. It records each call in
# $SB_HOME/gh-calls.log. `gh auth token` prints a token. `gh pr merge` first
# reads one line from $SB_HOME/gh-merge-gate when that file is a FIFO, so a
# test can keep the merge running. It then prints $SB_HOME/gh-merge-error to
# stderr and exits 1 when that file exists, and exits 0 otherwise. `gh pr
# edit` does the same with $SB_HOME/gh-edit-gate and $SB_HOME/gh-edit-error.
# `gh api graphql` prints $SB_HOME/gh-graphql.json when that file exists, and
# otherwise a PR by haacked for which GitHub suggests ann and haacked.
printf '%s\n' "$*" >>"$SB_HOME/gh-calls.log"
case "$1 $2" in
"auth token")
  echo "token-1"
  ;;
"pr merge")
  if [ -p "$SB_HOME/gh-merge-gate" ]; then read -r _ <"$SB_HOME/gh-merge-gate"; fi
  if [ -f "$SB_HOME/gh-merge-error" ]; then
    cat "$SB_HOME/gh-merge-error" >&2
    exit 1
  fi
  ;;
"pr edit")
  if [ -p "$SB_HOME/gh-edit-gate" ]; then read -r _ <"$SB_HOME/gh-edit-gate"; fi
  if [ -f "$SB_HOME/gh-edit-error" ]; then
    cat "$SB_HOME/gh-edit-error" >&2
    exit 1
  fi
  ;;
"api graphql")
  if [ -f "$SB_HOME/gh-graphql.json" ]; then
    cat "$SB_HOME/gh-graphql.json"
  else
    echo '{"data":{"repository":{"pullRequest":{"author":{"login":"haacked"},"suggestedReviewers":[{"isAuthor":true,"isCommenter":false,"reviewer":{"login":"ann"}},{"isAuthor":true,"isCommenter":true,"reviewer":{"login":"haacked"}}]}}}}'
  fi
  ;;
*)
  exit 1
  ;;
esac
