#!/usr/bin/env bash
# Splits the tests into the swift test processes that bin/test --shards runs.
#
#   bin/lib/shard-plan <shards> <parts> <weights-file> < test-list
#
# The test list has one test per line, as `swift test list` prints them, such
# as IntegrationTests.FooTests/bar(). Prints one "<part> <slot> <filter>" line
# for each process, where <filter> is an extended regular expression for
# swift test --filter. Each part runs on its own machine, such as one CI job
# of a matrix, and runs its processes at once. In each part, slots 0 to
# <shards>-1 run integration suites. Slot <shards> runs the other test targets,
# in part 1 only. Slot <shards>+1 runs MeasureTests, in the last part only.
#
# Each integration suite, slowest first, goes to the shard with the least time
# so far, among the shards of every part. The weights file gives each suite's
# seconds, one "<seconds> <suite>" line each. bin/shard-weights rebuilds it
# from a CI log. A suite the file doesn't list gets its test count times the
# mean seconds per test of the suites with a weight above 0. A suite with
# weight 0 holds no slot in CI. Without the file, that splits the suites by
# test count. The other targets take seconds and run in their own process.
# Their time limits then never wait behind integration tests that block
# threads. MeasureTests skips its timing check while the load average is above
# the CPU count, as it is while the shards run, so bin/test runs it last, once
# the load drops.
#
# Exits 1 when the list has no MeasureTests suite or when a test matches no
# filter or more than one, and 2 on a bad argument.
set -euo pipefail
quiet=IntegrationTests.MeasureTests
[ $# -eq 3 ] || { echo "usage: bin/lib/shard-plan <shards> <parts> <weights-file> < test-list" >&2; exit 2; }
n=$1 parts=$2 weights=$3
[[ $n =~ ^[1-9][0-9]*$ ]] || { echo "shard-plan: the shard count must be a positive whole number, not '$n'" >&2; exit 2; }
[[ $parts =~ ^[1-9][0-9]*$ ]] || { echo "shard-plan: the part count must be a positive whole number, not '$parts'" >&2; exit 2; }
list=$(cat)
plan=$(awk -F/ -v weights="$weights" '
  BEGIN { while ((getline line < weights) > 0) { split(line, f, " "); seconds[f[2]] = f[1] } }
  { count[$1]++ }
  END { for (key in count) if ((key in seconds) && seconds[key] > 0) { listed += seconds[key]; tests += count[key] }
    rate = tests ? listed / tests : 1
    for (key in count) {
      w = (key in seconds) ? seconds[key] : count[key] * rate
      print w, key } }' <<<"$list" |
  sort -k1,1rn -k2,2 | awk -v n="$n" -v parts="$parts" -v quiet="$quiet" '
  { key = $2
    gsub(/\./, "\\.", key)
    p = 1
    s = n
    if ($2 == quiet) { p = parts; s = n + 1 }
    else if ($2 ~ /^IntegrationTests($|\.)/) {
      b = 0
      for (i = 1; i < n * parts; i++) if (load[i] < load[b]) b = i
      load[b] += $1
      p = int(b / n) + 1
      s = b % n
    }
    slot = p " " s
    keys[slot] = (slot in keys) ? keys[slot] "|" key : key }
  END { for (slot in keys) print slot, "^(" keys[slot] ")/" }' | sort -k1,1n -k2,2n)
if ! grep -q "^$parts $((n + 1)) " <<<"$plan"; then
  echo "shard-plan: the tests have no $quiet suite to run alone" >&2
  exit 1
fi
# A suite name that holds a regular expression's special character makes a
# filter that misses its own tests or matches another suite's.
if ! awk '
  NR == FNR { filters[NR] = $3; next }
  { hits = 0
    for (i in filters) if ($0 ~ filters[i]) hits++
    if (hits != 1) { print "shard-plan: " hits " filters match " $0 > "/dev/stderr"; bad = 1 } }
  END { exit bad }' <(printf '%s\n' "$plan") <(printf '%s\n' "$list"); then
  exit 1
fi
printf '%s\n' "$plan"
