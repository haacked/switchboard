#!/bin/bash
# A stand-in for claude in sbd's integration tests. It runs the hook command
# from the settings file with the payloads that the real claude sent in the
# same step, from claude/<step>.jsonl next to this file, which the real
# claude tier records. It answers each prompt on its own line:
#   ask ...          replies with a question
#   offer ...        replies with an offer of a next step
#   slow <n>         runs a Bash tool call of n seconds
#   background <n> [held]
#                    starts a background job of n seconds and ends the turn.
#                    It reports the job in a turn of its own 0.5 s after the
#                    job's process exits. With held, the report also waits
#                    until $SB_HOME/report exists. The job's pid goes to
#                    $SB_HOME/job.pid
#   interrupt ...    starts a tool call and stops, as Escape does. Claude
#                    Code sends no hook after Escape
#   fail ...         ends the turn with StopFailure, as an API error does
#   clear <uuid>     switches to another conversation, as /clear does
#   linger <n>       waits n s after SIGTERM before it exits
#   lag ...          waits 1 s before it reports the prompt, which keeps the
#                    message in flight
#   perm <command>   asks permission to run a Bash command
#   pick             asks two questions with AskUserQuestion, the second
#                    one multi-select
#   For perm and pick, the PermissionRequest hook runs while a stand-in for
#   Claude Code's dialog reads a line from the terminal: y allows, and esc
#   refuses and kills the hook, as Claude Code closes the request. timeout
#   kills the hook and leaves the dialog open, as the hook's timeout does.
#   perm and pick build their tool payloads by hand. The stub does not play
#   permission.jsonl or question.jsonl yet.
#   mcp <name>       fetches that server's URL from the --mcp-config file and
#                    replies "MCP <name>: <answer>"
#   anything else    replies "Done: <prompt>"
# `claude agents ...` prints $CLAUDE_CONFIG_DIR/agents.json, a fixture that
# the test writes, or [] when it can't be read.
# Like claude, it writes a line to the conversation's transcript for each
# prompt and for clear, at the transcript_path that the hook payloads name.
# --resume fails when no transcript exists, and --session-id fails when one
# does. Without CLAUDE_CONFIG_DIR, claude would use the user's ~/.claude, so
# the stub uses $SB_HOME/claude instead.
# With STUB_HOOKS=off it runs no hooks, as when every hook fails.
# Each run appends one record to $SB_HOME/stub-calls.log in one write:
# CLAUDE_CONFIG_DIR, SSH_AUTH_SOCK and the arguments, split by tabs. A NUL
# ends the record, because a prompt can hold a newline.

args=("$@")
printf '%s\t%s\t%s\0' "${CLAUDE_CONFIG_DIR-}" "${SSH_AUTH_SOCK-}" "${args[*]}" >>"$SB_HOME/stub-calls.log"
if [ "${1-}" = agents ]; then
  cat "${CLAUDE_CONFIG_DIR-}/agents.json" 2>/dev/null || echo '[]'
  exit 0
fi
config_dir=${CLAUDE_CONFIG_DIR:-$SB_HOME/claude}
# Claude names a project's folder after its cwd, as emit fills {{encoded_cwd}}.
project="$config_dir/projects/$(jq -rn --arg c "$PWD" '$c | gsub("[^A-Za-z0-9]"; "-")')"

recordings="$(dirname "$0")/claude"
settings='' mcp_config='' session='' prompt='' source=startup linger=0
while [ $# -gt 0 ]; do
  case $1 in
  --settings) settings=$2 && shift 2 ;;
  --mcp-config) mcp_config=$2 && shift 2 ;;
  --session-id) session=$2 && shift 2 ;;
  --resume) session=$2 source=resume && shift 2 ;;
  --model | --permission-mode) shift 2 ;;
  --) prompt=${2:-} && break ;;
  --*) shift ;;
  *) prompt=$1 && shift ;;
  esac
done
hook_cmd=$(jq -r '.hooks.Stop[0].hooks[0].command' "$settings")
request_cmd=$(jq -r '.hooks.PermissionRequest[0].hooks[0].command' "$settings")

# payload <event> [json fields]: a hook payload shaped like claude's. It names
# the transcript, as claude's does, even before the file exists.
payload() {
  jq -nc --arg e "$1" --arg s "$session" --arg t "$project/$session.jsonl" --argjson f "${2:-{\}}" \
    '{hook_event_name: $e, session_id: $s, transcript_path: $t} + $f'
}

# transcript <text>: appends a line to the conversation's transcript.
transcript() {
  mkdir -p "$project"
  jq -nc --arg t "$1" '{type: "user", message: {role: "user", content: $t}}' >>"$project/$session.jsonl"
}

# hook <event> [json fields]
hook() {
  [ "${STUB_HOOKS-}" = off ] && return 0
  payload "$@" | sh -c "$hook_cmd" >/dev/null
}

# dialog <fields>: runs the PermissionRequest hook while the terminal's dialog
# waits for a line, and prints the first answer: "hook <output>" or
# "terminal <line>". A hook that prints nothing made no decision, so the
# dialog keeps waiting. The hook's pid goes to $SB_HOME/held-hook.pid.
dialog() {
  local out term hook_pid reader_pid said answer=''
  out=$(mktemp) term=$(mktemp)
  payload PermissionRequest "$1" | sh -c "exec $request_cmd" >"$out" &
  hook_pid=$!
  echo "$hook_pid" >"$SB_HOME/held-hook.pid"
  { IFS= read -r line && printf '%s\n' "$line" >"$term"; } <&3 &
  reader_pid=$!
  while [ -z "$answer" ]; do
    if [ -n "$hook_pid" ] && ! kill -0 "$hook_pid" 2>/dev/null; then
      [ -s "$out" ] && answer="hook $(cat "$out")"
      hook_pid=''
    fi
    # One read per pass, so a line that arrives mid-pass waits for the next.
    said=$(cat "$term")
    if [ -z "$answer" ] && [ "$said" = timeout ]; then
      [ -n "$hook_pid" ] && kill "$hook_pid"
      : >"$term"
      { IFS= read -r line && printf '%s\n' "$line" >"$term"; } <&3 &
      reader_pid=$!
    elif [ -z "$answer" ] && [ -n "$said" ]; then
      answer="terminal $said"
    fi
    sleep 0.1
  done
  kill "$reader_pid" 2>/dev/null
  [ "$answer" = "terminal esc" ] && [ -n "$hook_pid" ] && kill "$hook_pid"
  rm -f "$out" "$term"
  printf '%s' "$answer"
}

# vars <prompt> <reply> [command]: the values that fill a step's placeholders.
vars() {
  jq -nc --arg p "$1" --arg r "$2" --arg c "${3:-}" '{prompt: $p, reply: $r, command: $c, description: $p}'
}

# emit [vars] [<text> <command>]: runs the hook command with each payload on
# stdin, and runs the shell command before the first payload that contains
# the text. Each {{name}} takes its value from the vars, or from this session for
# its id and folders. The Claude config folder is $config_dir, and the
# folders that claude keeps in /tmp move into $SB_HOME. The loop runs in this shell and
# not in a pipeline's subshell, so a SIGKILL also stops the hooks that remain.
emit() {
  local extra=${1:-'{}'} payload paused='' payloads
  payloads=$(jq -c --arg s "$session" --arg cwd "$PWD" --arg home "$SB_HOME" --arg config "$config_dir" --argjson extra "$extra" '
    ({session_id: $s, cwd: $cwd, encoded_cwd: ($cwd | gsub("[^A-Za-z0-9]"; "-")), config_dir: $config,
      claude_tmp: "\($home)/tmp", home: env.HOME} + $extra) as $v
    | walk(if type == "string" then
        reduce ($v | to_entries[]) as $e (.; gsub("\\{\\{\($e.key)\\}\\}"; $e.value))
      else . end)')
  while IFS= read -r payload; do
    [ -z "$payload" ] && continue
    if [ -n "${2:-}" ] && [ -z "$paused" ] && [[ $payload == *"$2"* ]]; then
      eval "$3"
      paused=1
    fi
    [ "${STUB_HOOKS-}" = off ] || printf '%s\n' "$payload" | sh -c "$hook_cmd" >/dev/null
  done <<<"$payloads"
}

# play <step> [vars] [<text> <command>]: emits each payload of the recorded step.
play() {
  local step=$1
  shift
  emit "$@" <"$recordings/$step.jsonl"
}

# event <step> <event>: the payloads of one hook event in the recorded step.
event() { jq -c --arg e "$2" 'select(.hook_event_name == $e)' "$recordings/$1.jsonl"; }

# answered <tool> <input> <answer> [terminal input]: finishes a call that
# dialog answered. It prints the reply, or nothing when the turn stopped.
answered() {
  local tool=$1 input=$2 answer=$3 decision
  case $answer in
  "terminal y")
    input=${4:-$input}
    ;;
  "terminal esc")
    stopped
    return
    ;;
  hook*)
    decision=$(printf '%s' "${answer#hook }" | jq -c .hookSpecificOutput.decision)
    case $(jq -r .behavior <<<"$decision") in
    allow) input=$(jq -c --argjson i "$input" '.updatedInput // $i' <<<"$decision") ;;
    deny)
      if [ "$(jq -r .interrupt <<<"$decision")" = true ]; then
        stopped
      elif [ "$tool" = AskUserQuestion ]; then
        echo "Waiting for your answer."
      else
        echo "Denied: $(jq -r .message <<<"$decision")"
      fi
      return
      ;;
    esac
    ;;
  esac
  hook PostToolUse "$(jq -nc --arg t "$tool" --argjson i "$input" '{tool_name: $t, tool_use_id: "c1", tool_input: $i}')"
  if [ "$tool" = AskUserQuestion ]; then
    echo "Picked: $(jq -cS .answers <<<"$input")"
  else
    echo "Ran $(jq -r .command <<<"$input")"
  fi
}

# call_tool <tool> <input> [input after a pick in the terminal]: runs a call
# that needs permission, and prints the reply, or nothing when the turn
# stopped.
call_tool() {
  local fields
  fields=$(jq -nc --arg t "$1" --argjson i "$2" '{tool_name: $t, tool_input: $i}')
  hook PreToolUse "$(jq -c '. + {tool_use_id: "c1"}' <<<"$fields")"
  answered "$1" "$2" "$(dialog "$fields")" "${3:-}"
}

# stopped: ends the turn without a Stop, as an interruption does. Claude Code
# reports the idle prompt later.
stopped() {
  echo "⏺ Interrupted" >&2
  sleep 1
  hook Notification '{"notification_type":"idle_prompt","message":"Claude is waiting for your input"}'
}

# asks <prompt> <tool> <input> [input after a pick in the terminal]: plays
# the recorded turn around a call that needs permission. The turn has no Stop
# when the call stopped it.
asks() {
  local reply
  event turn UserPromptSubmit | emit "$(vars "$1" "")"
  reply=$(call_tool "${@:2}")
  [ -z "$reply" ] && return
  echo "⏺ $reply"
  event turn Stop | emit "$(vars "$1" "$reply")"
}

questions='{"questions":[
  {"question":"Which fruit?","header":"Fruit","multiSelect":false,
   "options":[{"label":"apple","description":"A red fruit"},{"label":"cherry","description":"A small fruit"}]},
  {"question":"Which colors?","header":"Colors","multiSelect":true,
   "options":[{"label":"red"},{"label":"blue"},{"label":"green"}]}]}'

turn() {
  local p=$1 step=turn reply cmd='' marker='' before='' n job held
  case $p in lag*) sleep 1 ;; esac
  transcript "$p"
  case $p in
  slow*)
    n=${p#slow }
    step=tool reply="Slept $n s." cmd="sleep $n" marker='"hook_event_name":"PostToolUse"' before="sleep $n"
    ;;
  background*)
    read -r n held <<<"${p#background }"
    rm -f "$SB_HOME/job.pid"
    # Claude Code runs each background job in a process group of its own,
    # and its spawn returns after the job is in that group. perl writes the
    # job's pid once the job is there, and the turn waits for that.
    perl -e 'setpgrp(0, 0); open(my $f, ">", shift) or die; print $f $$; close $f; exec @ARGV' \
      "$SB_HOME/job.pid" sleep "$n" &
    job=$!
    while kill -0 $job 2>/dev/null && [ ! -s "$SB_HOME/job.pid" ]; do sleep 0.01; done
    step=background-job reply="Started a job of $n s." cmd="sleep $n" marker='<task-notification>'
    before="while kill -0 $job 2>/dev/null; do sleep 0.05; done; sleep 0.5"
    [ "$held" = held ] && before="$before; until [ -e '$SB_HOME/report' ]; do sleep 0.05; done"
    ;;
  interrupt*)
    play interrupt "$(vars "$p" "" "sleep 100")"
    echo "⏺ Interrupted"
    return
    ;;
  fail*)
    event turn UserPromptSubmit | emit "$(vars "$p" "")"
    hook StopFailure '{"error":"rate_limit"}'
    echo "⏺ API Error"
    return
    ;;
  clear*)
    play clear "$(jq -nc --arg n "${p#clear }" '{session_id_2: $n}')"
    session=${p#clear }
    transcript /clear
    echo "⏺ cleared, now $session"
    return
    ;;
  mcp\ *)
    url=$(jq -r --arg n "${p#mcp }" '.mcpServers[$n].url' "$mcp_config")
    reply="MCP ${p#mcp }: $(curl -s --max-time 2 "$url" || echo "no answer from $url")"
    ;;
  linger*)
    linger=${p#linger }
    reply="I'll linger $linger s when I stop."
    ;;
  perm*)
    asks "$p" Bash "$(jq -nc --arg c "${p#perm }" '{command: $c}')"
    return
    ;;
  pick*)
    asks "$p" AskUserQuestion "$questions" \
      "$(jq -c '. + {answers: {"Which fruit?": "apple", "Which colors?": "red"}}' <<<"$questions")"
    return
    ;;
  ask*) reply="Which database should I use, Postgres or SQLite?" ;;
  offer*) reply="I wrote the parser. Want me to run the tests?" ;;
  *) reply="Done: $p" ;;
  esac
  echo "⏺ $reply"
  play "$step" "$(vars "$p" "$reply" "$cmd")" "$marker" "$before"
}

ls "$config_dir"/projects/*/"$session.jsonl" >/dev/null 2>&1 && found=yes || found=no
case $source:$found in
startup:yes) echo "Error: Session ID $session is already in use." && exit 1 ;;
resume:no) echo "No conversation found with session ID: $session" && exit 1 ;;
esac
trap 'play sigterm; sleep "$linger"; exit 143' TERM
# The dialog's reader runs in the background, where stdin would be /dev/null.
exec 3<&0
play "$source"
echo "claude-stub $session ($source)"
[ -n "$prompt" ] && turn "$prompt"
while IFS= read -r line; do
  [ -n "$line" ] && turn "$line"
done
