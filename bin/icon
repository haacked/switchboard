#!/usr/bin/env bash
# Renders assets/icon/AppIcon.svg into assets/icon/AppIcon.icns. Needs
# rsvg-convert (brew install librsvg) and iconutil. The .icns is committed, so
# bin/bundle runs without either; run this only after editing the SVG.
set -euo pipefail
cd "$(dirname "$0")/.."
command -v rsvg-convert >/dev/null || { echo "rsvg-convert not found (brew install librsvg)" >&2; exit 1; }
dir=assets/icon
set=$(mktemp -d)/AppIcon.iconset
mkdir -p "$set"
for size in 16 32 128 256 512; do
  rsvg-convert -w "$size" -h "$size" "$dir/AppIcon.svg" -o "$set/icon_${size}x${size}.png"
  rsvg-convert -w $((size * 2)) -h $((size * 2)) "$dir/AppIcon.svg" -o "$set/icon_${size}x${size}@2x.png"
done
iconutil -c icns "$set" -o "$dir/AppIcon.icns"
rm -rf "$(dirname "$set")"
echo "$dir/AppIcon.icns"
